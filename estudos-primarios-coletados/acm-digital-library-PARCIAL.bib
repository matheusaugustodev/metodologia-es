@article{10.1145/3704262,
  author = {Cao, Yihan and Li, Siyu and Liu, Yixin and Yan, Zhiling and Dai, Yutong and Yu, Philip and Sun, Lichao},
  title = {A Survey of AI-Generated Content (AIGC)},
  journal = {ACM Comput. Surv.},
  year = {2025},
  month = {jan},
  volume = {57},
  number = {5},
  pages = {1–38},
  numpages = {38},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3704262},
  url = {https://doi.org/10.1145/3704262},
  issn = {0360-0300},
  keywords = {Generative AI, AI-generated content, multimodal machine learning},
  abstract = {Recently, Artificial Intelligence Generated Content (AIGC) has gained significant attention from society, especially with the rise of Generative AI (GAI) techniques such as ChatGPT, GPT-4 [165], DALL-E-3 [184], and Sora [137]. AIGC involves using AI models to create digital content, such as images, music, and natural language, with the goal of making the content creation process more efficient and accessible. Large-scale models have become increasingly important in AIGC as they provide better intent extraction and generation results. This survey provides a comprehensive review of the history of generative models and recent advances in AIGC, focusing on both unimodal and multimodal interaction. From the perspective of unimodality, we introduce the generation tasks and relative models of text and image. From the perspective of multimodality, we introduce the cross-application between the modalities mentioned above. Finally, the survey discusses the existing open problems and future challenges in AIGC. Overall, this survey serves as a valuable resource for individuals interested in understanding the background and secrets behind the impressive performance of AIGC techniques.}
}

@inproceedings{10.1145/3764206.3764215,
  author = {Zhu, Feng and Zeng, Zhou and Sun, Kai},
  title = {A Novel Teaching Method for Database Courses Based on AI-Driven Automated Programming},
  booktitle = {Proceedings of the 2nd International Conference on Intelligent Education and Computer Technology},
  year = {2025},
  month = {nov},
  pages = {54–64},
  numpages = {11},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3764206.3764215},
  url = {https://doi.org/10.1145/3764206.3764215},
  isbn = {9798400714306},
  keywords = {AI-driven, Advanced skill development, Automated programming, Database courses, Human-machine collaboration},
  abstract = {To address the challenges posed by the rapid development of AI-driven automated programming technologies to database course teaching in vocational colleges, this study explores innovative teaching methods based on AI tools. By analyzing the differences between traditional MySQL database course content, real-world development processes, and the auxiliary functions of AI tools, it was found that the course aligns well with foundational knowledge and basic stages of development processes but severely lacks coverage in advanced tasks. To address this issue, the study proposes three core teaching principles: ``human-machine collaboration," ``learning by doing and reflective learning," and ``focus on design rather than implementation." Based on these principles, a teaching framework centered around AI tools was designed, covering key teaching stages such as requirements analysis, database design, coding implementation, performance optimization, system testing, and knowledge review. The teaching framework is implemented through a project-based approach, using the development of an e-commerce system as a case study. It integrates AI-assisted full-process development tasks to help students complete comprehensive practice training, from requirements analysis to system optimization. Experimental results show that the AI-based teaching approach significantly enhances students' interest and motivation in learning. By reducing repetitive operations in basic tasks, the approach shifts students' learning focus to complex business modeling and advanced design tasks. However, the uncertainty of AI tools remains a major challenge in teaching, requiring students to undergo more training to improve their collaboration skills and prompt design abilities. The main contribution of this study lies in proposing a novel teaching framework for database courses driven by AI-based automated programming, and validating its value in improving students' learning efficiency, fostering advanced skills, and adapting to modern development environments. This provides theoretical support and practical pathways for modern database course reform, with significant educational significance and industry application value.}
}

