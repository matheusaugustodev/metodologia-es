@inproceedings{10.1145/3813822.3814139,
  author = {Peng, Mingpei and Zhang, Ning},
  title = {WDDQA: A Large Language Model-Based Question-answering System in Instruction for the Web Design and Development Course},
  booktitle = {Proceedings of the 2026 7th International Conference on Computer Information and Big Data Applications},
  year = {2026},
  month = {sep},
  pages = {1981–1987},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3813822.3814139},
  url = {https://doi.org/10.1145/3813822.3814139},
  isbn = {9798400722578},
  keywords = {LLM Tools, Question-answering System, Teaching Innovation, Web Design and Production, large Language Model},
  abstract = {Large language Models (LLMs) have shown remarkable performance on various natural language processing, including educational question answering. While general-purpose LLMs are capable of addressing certain coding queries, they may not always be optimally suited for specialized educational contexts, such as software technology course at vocational colleges. To address this difficulty, this study introduces a Web Design and Development question-answering System (WDDQA) comprehensively built by ChatGLM3-6B and Langchain-Chatchat. WDDQA assists students in real-time code correction and provide relevant code examples and knowledge. By integrating students’ textbooks with learning data, WDDQA provides explanations that are more accessible and tailored to their comprehension level. Teaching evaluation indicate that after implementing WDDQA in class, the number of student assignment submissions saw an increase of 10\%, and the code debugging success rate experienced an increase of 13\%. The application of the WDDQA not only enhances student engagement but also improves the quality of code submissions, offering a practical reference for the implementation of AI-supported education.}
}

@article{10.1145/3808133,
  author = {Liu, Mingwei and Pei, Zheng and Wang, Yanlin and Wang, Zihao and Li, Zikang and Lin, Enci and Peng, Xin and Zheng, Zibin},
  title = {Knowledge-Graph-Driven Data Synthesis for Low-Resource Software Development: A HarmonyOS Case Study},
  journal = {Proc. ACM Softw. Eng.},
  year = {2026},
  month = {jun},
  volume = {3},
  number = {FSE},
  pages = {2835–2857},
  numpages = {23},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3808133},
  url = {https://doi.org/10.1145/3808133},
  keywords = {API Knowledge Graph, Data Synthesis, Domain Code Generation, HarmonyOS},
  abstract = {In low-resource framework development (e.g., HarmonyOS), large language models (LLMs) often lack sufficient pre-training exposure, resulting in poor code generation performance. Although they generally preserve programming logic across languages, they frequently fail on framework-specific APIs and syntax, revealing a gap between learned algorithmic knowledge and unfamiliar framework conventions. Consequently, even advanced models such as GPT-4o struggle to produce correct code without prior exposure. Inspired by these challenges, we propose APIKG4SYN, a framework that leverages API knowledge graphs to synthesize API-oriented question–code pairs without requiring executable environments. It incorporates both single-API and multi-API information, with the latter guided by uncertainty estimation (UE) and Monte Carlo Tree Search (MCTS), to construct high-quality fine-tuning data. For evaluation, we select HarmonyOS as a case study due to its accessible documentation and growing ecosystem, and build the first benchmark for its code generation. Experimental results show that fine-tuning Qwen2.5-Coder-7B with APIKG4SYN achieves a pass@1 of 25.00\%, outperforming untuned GPT-4o (17.59\%). We further observe that larger volumes of data generated by APIKG4SYN consistently lead to better fine-tuning performance, and that the optimal Single-API to Multi-API ratio is 8:2. Ablation studies also confirm the necessity and effectiveness of each component in our framework. These findings highlight the effectiveness of API-oriented data in enhancing LLM performance for low-resource software development scenarios.}
}

