@inproceedings{10.1145/3769872.3769886,
  author = {Payandeh, Mohammad Hasan and Zhao, Jian},
  title = {SenseSync: Supporting Collaborative Information-Seeking with the Involvement of Large Language Models},
  booktitle = {Proceedings of the 51st Graphics Interface Conference 2025},
  year = {2026},
  month = {apr},
  number = {Article 31},
  pages = {1–19},
  numpages = {19},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3769872.3769886},
  url = {https://doi.org/10.1145/3769872.3769886},
  isbn = {9798400718762},
  keywords = {Information Seeking, Collaboration, Sense-making, Large Language Models (LLMs), Graph Visualization, Temporal Visualization.},
  abstract = {Recently, tools driven by Large Language Models (LLMs), such as ChatGPT, have been extensively used for gathering information. While LLMs improve efficiency in individual tasks, new challenges emerge in collaborative information-seeking when user groups collect data from their conversations with AI that have various contexts. To fill this knowledge gap, we investigate these challenges and reflect on them via the design, development, and evaluation of SenseSync. SenseSync supports collaborative work involving LLMs from different perspectives, featuring a dynamic graph to display individual and shared conversations with LLMs and a visual timeline for exploring collaborative activities over different periods. Moreover, SenseSync is enriched with contextual information and specific support for LLM-assisted information-seeking. A summative study was conducted to explore how pairs of participants used the tool, enriching our understanding of LLM-assisted collaborative information-seeking tasks.}
}

@article{10.1145/3858331,
  author = {Ouh, Eng Lieh and Tan, Kar Way and Lo, Siaw Ling and Siew Gan, Benjamin Kok and Zhang, Yuhao},
  title = {ChatGPT, Can You Generate Multiple-Choice Questions for an Undergraduate Computing Course? An Evaluation of its Effectiveness Using Classical Test Theory},
  journal = {ACM Trans. Comput. Educ.},
  year = {2026},
  month = {oct},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3858331},
  url = {https://doi.org/10.1145/3858331},
  keywords = {Classical Test Theory, multiple-choice questions, item analysis, point-biserial correlation, AI-assisted assessment, computing education},
  abstract = {Educators are increasingly adopting large language models such as ChatGPT to generate multiple-choice questions (MCQs), yet empirical evidence on the quality of these items in computing education assessments remains limited. This study compares 30 ChatGPT-generated and 30 manually crafted items from an undergraduate software design course, and evaluates item difficulty, discrimination, and distractor quality using Classical Test Theory. We triangulated two evaluations using within-subjects and between-subjects designs. Our quantitative findings show that all three metrics in both evaluations point in the same direction. ChatGPT-generated items are easier, less discriminating, and exhibit poorer distractor quality than manually crafted items. Distractor quality of ChatGPT-generated items is significantly worse in both designs. Difficulty metric is significant in the within-subjects design and discrimination metric is significant in the between-subjects design. We discuss the quantitative findings for each evaluation and across the two evaluations. A qualitative analysis further identifies six construction patterns in ChatGPT-generated MCQs that contribute to non-functioning distractors and help explain their psychometric characteristics. These patterns provide practical guidance for instructors to review and revise ChatGPT-generated items before deployment.}
}

