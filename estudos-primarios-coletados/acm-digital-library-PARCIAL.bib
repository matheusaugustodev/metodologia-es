@inproceedings{10.1145/3786160.3788471,
  author = {Abadeh, Parya and Lochner, Martin and Ansari, Taha and Zarrinkalam, Fattane},
  title = {MCP-Scanner: Detecting Security Risks in Model Context Protocol Systems},
  booktitle = {Proceedings of the 2026 ACM/IEEE 7th International Workshop on Engineering and Cybersecurity of Critical Systems},
  year = {2026},
  month = {may},
  pages = {41–48},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786160.3788471},
  url = {https://doi.org/10.1145/3786160.3788471},
  isbn = {9798400723926},
  keywords = {Model Context Protocol (MCP), GenAI Security, Software and Application Security},
  abstract = {Integrating Artificial Intelligence (AI) models, especially Large Language Models (LLMs), with external tools is crucial for performing real-world tasks. However, the lack of a standard way to connect these tools has led to fragmented systems and new security risks. The Model Context Protocol (MCP) was introduced to solve this by providing a unified way for AI to interact with services. Despite its benefits, MCP’s open design creates new areas for attacks, making security a major concern. To address this, we introduce MCP-Scanner, the first comprehensive tool designed to automatically find a wide range of vulnerabilities in MCP servers. Unlike other tools that focus only on specific features like tools, MCP-Scanner checks all MCP features, including tools, prompts, and resources. It uses a multi-layered approach that combines keyword detection, semantic analysis, and evaluation by an LLM to find complex threats like variable and tool poisoning, prompt injection, rug pull attacks, and server impersonation, and addresses potential threats at each identified ’Trust Boundary’. Our experiments on custom-built vulnerable servers and real online MCP servers show that MCP-Scanner is very effective and accurate. This work provides a vital tool for developers and researchers to build safer and more trustworthy AI agentic systems. The MCP-Scanner implementation is publicly available as open-source software.}
}

@inbook{10.1145/3793302.3793335,
  author = {Maarleveld, Jesse and Destefanis, Giuseppe and Feitosa, Daniel},
  title = {Evolving Kubernetes: A Technical Debt Perspective},
  booktitle = {Proceedings of the 23rd International Conference on Mining Software Repositories},
  year = {2026},
  month = {jul},
  pages = {14–25},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3793302.3793335},
  url = {https://doi.org/10.1145/3793302.3793335},
  isbn = {9798400724749},
  abstract = {Kubernetes is one of the most active and long-lived open source projects, supporting core infrastructure for organisations worldwide. Its decade-long development has involved major architectural changes, multiple governance layers, and sustained efforts to manage technical debt without compromising stability. In this study, we examine the evolution of technical debt in Kubernetes by analysing a longitudinal dataset of 83,368 pull requests and 9,981 mailing list messages in 3,801 threads, spanning from the project’s inception in 2014 through July 2025. We investigate when technical debt became a prominent concern in the community, how it was addressed through cleanup activities across different organisational units, and what emotional dynamics accompanied debt-related discussions. Our analysis combines LLM-based classification of mailing list discussions, time series analysis of pull request labels, and emotion detection in developer communications. The findings show that technical debt discussions peaked in 2016–2017, that the project maintained consistent cleanup effort since 2018, and that community attitudes towards debt remediation became increasingly positive over time. These results indicate how large-scale open source projects can embed technical debt management into organisational structure, labelling practices, and cultural norms.}
}

@inproceedings{10.1145/3772318.3790459,
  author = {Awasthi, Urvi and Krayer, Lisa and Sack, Daniel},
  title = {TurnStyle: A Framework for Analyzing Human Conversational Behaviors to Predict Success in LLM-Assisted Tasks},
  booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
  year = {2026},
  month = {apr},
  number = {Article 126},
  pages = {1–13},
  numpages = {13},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3772318.3790459},
  url = {https://doi.org/10.1145/3772318.3790459},
  isbn = {9798400722783},
  keywords = {human–AI collaboration, human-LLM collaboration, large language models (LLMs), natural language interfaces, conversational analysis, turn-level taxonomy, hidden Markov models, empirical study},
  abstract = {LLMs are widespread across educational and professional environments, often used to tackle tasks beyond users’ prior expertise. However, there is limited work on task-agnostic, turn-level frameworks to characterize human communication styles with LLMs that are linked to better task outcomes. We introduce TurnStyle, a framework that provides a turn-level taxonomy of human contributions in human–AI conversations, grounded in collaborative learning theory, with a reliability protocol and open-source tooling for public datasets. We apply TurnStyle to two public multi-turn corpora with objective outcomes – StudyChat (college-level assignments) and DevGPT (software engineering issues and pull requests (PRs)) – and to a workplace reskilling randomized trial in which management consultants used ChatGPT for coding, statistics, and machine learning. Across 3,365 conversations with 26,335 human turns spanning the three datasets, mixed-effects and sequence analyses converge on task-agnostic, trainable behaviors that predict task success; this has implications for training, evaluation, and the design of collaborative AI systems.}
}

