@inproceedings{10.1145/3676641.3716267,
  author = {Gu, Yufeng and Khadem, Alireza and Umesh, Sumanth and Liang, Ning and Servot, Xavier and Mutlu, Onur and Iyer, Ravi and Das, Reetuparna},
  title = {PIM Is All You Need: A CXL-Enabled GPU-Free System for Large Language Model Inference},
  booktitle = {Proceedings of the 30th ACM International Conference on Architectural Support for Programming Languages and Operating Systems, Volume 2},
  year = {2025},
  month = {mar},
  pages = {862–881},
  numpages = {20},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3676641.3716267},
  url = {https://doi.org/10.1145/3676641.3716267},
  isbn = {9798400710797},
  keywords = {compute express link, computer architecture, generative artificial intelligence, large language models, processing-in-memory},
  abstract = {Large Language Model (LLM) inference uses an autoregressive manner to generate one token at a time, which exhibits notably lower operational intensity compared to earlier Machine Learning (ML) models such as encoder-only transformers and Convolutional Neural Networks. At the same time, LLMs possess large parameter sizes and use key-value caches to store context information. Modern LLMs support context windows with up to 1 million tokens to generate versatile text, audio, and video content. A large key-value cache unique to each prompt requires a large memory capacity, limiting the inference batch size. Both low operational intensity and limited batch size necessitate a high memory bandwidth. However, contemporary hardware systems for ML model deployment, such as GPUs and TPUs, are primarily optimized for compute throughput. This mismatch challenges the efficient deployment of advanced LLMs and makes users to pay for expensive compute resources that are poorly utilized for the memory-bound LLM inference tasks.We propose CENT, a CXL-ENabled GPU-Free sysTem for LLM inference, which harnesses CXL memory expansion capabilities to accommodate substantial LLM sizes, and utilizes near-bank processing units to deliver high memory bandwidth, eliminating the need for expensive GPUs. CENT exploits a scalable CXL network to support peer-to-peer and collective communication primitives across CXL devices. We implement various parallelism strategies to distribute LLMs across these devices. Compared to GPU baselines with maximum supported batch sizes and similar average power, CENT achieves 2.3x higher throughput and consumes 2.3x less energy. CENT reduces the Total Cost of Ownership (TCO), generating 5.2x more tokens per dollar than GPUs.}
}

@inproceedings{10.1145/3775073.3775117,
  author = {Gao, Chaomin and Zhong, Lin},
  title = {An Empirical Study on Enhancing Academic Abstract Quality via Quantitative Scoring and Large Language Model Application: Evidence from “Digital Economy” Themed Papers on CNKI},
  booktitle = {Proceedings of the 2025 2nd International Symposium on Artificial Intelligence for Education},
  year = {2025},
  month = {dec},
  pages = {263–269},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3775073.3775117},
  url = {https://doi.org/10.1145/3775073.3775117},
  isbn = {9798400715792},
  keywords = {Abstract quality assessment, Academic paper abstract, Large Language Model, Scholarly communication},
  abstract = {The aim of our study was to evaluate the quality of academic text abstracts and to check if LLM models could enhance the abstracts automatically. We obtained the data through a quantitative and empirical approach. For instance, the digital economy sector is a relatively topical focal point and appears to be in demand in academia. First, we turned our attention to the 5,054 papers published on "Digital Economy" from the CNKI (China National Knowledge Infrastructure) database. For these, we came up with an 8-point scoring model that covered four areas, including the purpose of the research, the methodology, the results, and the conclusion, and we used it to evaluate the quality of the abstracts. Next, a digital search of papers revealed 30 papers that had low-scoring abstracts. We went along with the Tongyi Qianwen 2.5 model's specific prompts and fed in the full texts of these papers to further improve the abstracts. Thus, the same scoring model was employed to find out how good the LLMs-generated abstracts were. The quantitative research pointed to the significance that 57.44\% of the total abstracts did not describe the main content of the research correctly and logically well enough (with less than 8 points). The portions of research methods (which is a problem for 51.37\% of the papers) and the research results (for 52.31\% of the rapacious species) are the weakest. The comparison showed something interesting: the 30 abstracts that were generated by the model achieved full marks according to our marks. In particular, their format, logic, and key concept separation are all significantly better than the original. This work suggests that there are common problems with how academic abstracts are currently written, especially when it comes to describing methods and results. LLMs could be excellent technological instrumentations; they possess the capacity to produce and enhance abstracts to a great extent. They make abstracts almost standard and complete with information. This means they could be very precious if we employ them more widely.}
}

