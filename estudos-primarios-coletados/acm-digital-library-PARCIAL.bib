@inproceedings{10.1145/3797867.3829029,
  author = {Leonardi, Nicola and Manca, Marco and Paternò, Fabio},
  title = {Beyond LLMs: Small Multimodal Models for Semantic Accessibility Validation of Alternative Texts},
  booktitle = {Proceedings of the 28th International ACM SIGACCESS Conference on Computers and Accessibility},
  year = {2026},
  month = {oct},
  number = {Article 28},
  pages = {1–16},
  numpages = {16},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3797867.3829029},
  url = {https://doi.org/10.1145/3797867.3829029},
  isbn = {9798400725210},
  keywords = {Accessibility, LLM, SLM, User validation},
  abstract = {Generative artificial intelligence is opening up new possibilities in Web accessibility authoring and validation. Multimodal language models can address semantic analyses of Web content that have not been provided so far. Indeed, most available accessibility validation tools are limited to syntactic analysis, focusing mainly on whether required elements are present. Some work has been put forward to explore the possibilities of large language models. However, such models raise several issues regarding cost, privacy, and sustainability. To address such issues, we have conducted a study investigating the feasibility of small, open-weighted models for the semantic analysis of a common accessibility issue: whether the alternative textual descriptions of images provide sufficient equivalent information (Success Criterion 1.1.1 Non-text Content). In the paper, we present how we have fine-tuned the small language model, and the results of a user test involving 30 experts in accessibility validation, in which they had to rate the results of the assessment performed by a large language model (GPT–4o), a small visual-language model and perform the same task themselves over 645 images. The results show that visual-language models can provide useful support for this type of task, and a small, appropriately trained language model tends to achieve even better results than a large one. These results show that novel paths for authoring and validating Web content accessibility can be enabled by small language models.}
}

@inproceedings{10.1145/3803730.3803759,
  author = {Yang, Le and Chen, Xingyuan and Pang, Bingyao and Huo, Yongbo and Zhan, Xinrui and Guo, Yiming and Li, Yifan and Ma, Yanhao and Li, Chonghao},
  title = {A Reference-Free Scoring Framework for Question Answering: Evidence-Based Credibility Assessment},
  booktitle = {Proceedings of the 2026 2nd International Conference on Generative Artificial Intelligence and Digital Media},
  year = {2026},
  month = {may},
  pages = {170–177},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3803730.3803759},
  url = {https://doi.org/10.1145/3803730.3803759},
  isbn = {9798400722080},
  keywords = {Question Answering Evaluation, Reference-Free Assessment, Evidence-Based Scoring, Answer Credibility, Multi-Candidate Ranking},
  abstract = {Evaluating question answering (QA) systems traditionally relies on human-annotated reference answers, a paradigm that faces practical limitations in real-world, dynamic applications where references are unavailable, expensive to produce, or quickly become outdated. To address these issues, this paper proposes a novel reference-free scoring framework that directly assesses the credibility of a candidate answer given a question and its supporting context. Our method decomposes answer quality into interpretable, evidence-based signals—including sample-level answerability, and candidate-level measures of confidence, coverage, and faithfulness—and combines them into a unified credibility score S(Q, C, A) via a lightweight fusion model. This score enables the ranking of multiple candidate answers without requiring a gold-standard reference. We validate the framework through a multi-candidate re-ranking task, demonstrating that higher-scoring answers consistently correspond to better quality as measured by standard benchmarks like Exact Match and F1. Crucially, our approach excels in handling unanswerable questions, achieving a more balanced performance compared to LLM-as-a-judge baselines while being more computationally efficient. The framework provides a flexible, diagnostically meaningful, and scalable alternative for QA evaluation in reference-scarce or dynamic environments.}
}

@inproceedings{10.1145/3786148.3788619,
  author = {Kumar, Punit and Imran, Asif and Kosar, Tevfik},
  title = {Energy Consumption of Dataframe Libraries for End-to-End Deep Learning Pipelines - A Comparative Analysis},
  booktitle = {Proceedings of the IEEE/ACM 10th International Workshop on Green and Sustainable Software},
  year = {2026},
  month = {jul},
  pages = {14–21},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786148.3788619},
  url = {https://doi.org/10.1145/3786148.3788619},
  isbn = {9798400723810},
  keywords = {Pandas, Polars, Dask, Deep Learning, Performance Evaluation, Energy Efficiency, Training, Inference, End-to-end Pipeline},
  abstract = {This paper presents a comparative performance analysis of three popular Python data manipulation libraries—Pandas, Polars, and Dask—within the context of deep learning training pipelines. The existing studies in this area do not embed the libraries inside a full deep-learning training pipeline where data loading, preprocessing, and batch feeding interact tightly with GPU workloads. To bridge this gap, we integrate Pandas, Polars, and Dask into representative deep learning training and inference pipelines and conduct experiments across a wide range of various machine learning models and datasets, measuring key performance indicators such as runtime, memory usage, disk usage, and energy consumption (CPU and GPU). Our comprehensive analysis reveals that Polars consistently minimizes CPU energy consumption on larger workloads, while Pandas remains competitive for moderate sizes. Dask’s overhead can lead to higher energy usage on small to moderate datasets. All three libraries achieve similar runtimes for heavy GPU workloads (ResNet, Mask R-CNN). Polars and Pandas maintain lower CPU memory footprints than Dask, but Dask offers easier scalability if data truly exceeds available RAM. Polars shows marginal energy savings on the CPU during preprocessing.}
}

@inbook{10.1145/3822380.3822393,
  author = {Chang, Edward Y.},
  title = {Quadrivium—System-2 MACI},
  booktitle = {System-2 Reasoning: From Semantic Anchoring to Causal Intelligence: The Path to Artificial General Intelligence, Volume 2},
  year = {2026},
  month = {jul},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3822380.3822393},
  url = {https://doi.org/10.1145/3822380.3822393},
  isbn = {9798400728044},
  abstract = {Large language models can write poetry, pass bar exams, and generate fluent code. Yet they continue to fail in the domains where intelligence must be accountable: distinguishing causation from correlation, recognizing when evidence is insufficient, preserving commitments over time,and correcting their own reasoning failures. This book argues that the transition from pattern matching to genuine reasoning requires a System-2 layer grounded in coordinated diagnosis, audit, causal validation, memory, and meta-cognitive control.The volume develops this architecture from first principles through operational protocols. Semantic Anchoring (Unified Cognitive Consciousness Theory) demonstrates how contextual constraints can bind latent model representations into governed reasoning processes rather than prior-driven completion. Regulated Causal Anchoring (RCA) and RAudit diagnose sycophancy, pathological skepticism, and trace-output inconsistency without relying exclusively on ground-truth supervision. The Causal Abstraction Bridge and the CausalTSK benchmark reveal where models collapse from interventional and counterfactual reasoning back into associative prediction.Epistemic Regret Minimization (ERM) identifies causal shortcuts and failures of warranted inference, while Reinforcement Learning from Epistemic Regret (RLER) transforms those reasoning failures into a structured learning signal. Trivium introduces temporal accountability through a Causal Transaction Log, and Quadrivium integrates contextual, causal, temporal, and meta-cognitive regulation into a unified System-2 MACI architecture.The author’s central thesis is that Artificial General Intelligence (AGI) will not emerge from scaling monolithic pattern-completion systems alone. AGI will require architectures capable of explaining why an answer is warranted, refusing conclusions when evidence remains indeterminate, and improving through epistemic failure.Written for researchers, advanced students, and practitioners, this book presents a framework for AI systems that are not merely impressive, but auditable, corrigible, and trustworthy. It is suitable for graduate-level courses in artificial intelligence, multi-agent systems, causal reasoning, and trustworthy AI.}
}

@inproceedings{10.1145/3797867.3841242,
  author = {Kim, Hayoon and Lee, Sungho and Kim, Juhwi and Suh, Bongwon and Lee, Kyogu},
  title = {LipCoder: Voice-Enabled Coding Toolkit},
  booktitle = {Proceedings of the 28th International ACM SIGACCESS Conference on Computers and Accessibility},
  year = {2026},
  month = {oct},
  number = {Article 144},
  pages = {1–20},
  numpages = {20},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3797867.3841242},
  url = {https://doi.org/10.1145/3797867.3841242},
  isbn = {9798400725210},
  keywords = {Accessibility, Auditory-first programming, Speech-driven IDE, Visually impaired programmers, Assistive technology, Speech recognition (ASR), Text-to-speech (TTS), Earcon, Auditory feedback},
  abstract = {AI-assisted programming environments have accelerated software development, giving rise to new paradigms like vibe coding. However, their benefits remain largely inaccessible to visually impaired programmers, as existing screen readers and assistive tools offer limited support for these emerging workflows. We introduce LipCoder, a voice-centric programming toolkit designed to deliver editor-level functionality through auditory and speech-based interfaces. LipCoder offers features comprising speech feedback and earcon cues for comprehension and validation, as well as natural language input for navigation and modification. In an exploratory evaluation, 5 visually impaired programmers performed a series of coding tasks comparing LipCoder with a baseline of VSCode, Copilot, and VoiceOver. Quantitative trends and qualitative feedback point to directions for auditory-first design that may broaden accessibility in speech-driven coding environments.}
}

@book{10.1145/3769002,
  title = {Proceedings of the International Conference on Research in Adaptive and Convergent Systems},
  series = {RACS '25},
  year = {2025},
  month = {oct},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3769002},
  isbn = {9798400722318},
  abstract = {With the expansion of advanced computing and network technologies, innovative solutions are developed to address complex problems in all areas of industry and science, using adaptive and convergent techniques in computer science and engineering, encompassing fields such as programming, software engineering, graphics, databases, wireless networks, security, distributed systems, operating systems, artificial intelligence, quantum computing and so on. The Research in Adaptive and Convergent Systems (RACS) provides a forum for exchanging highly original ideas about systematic, dynamic, practical solutions and aims primarily at researchers who have experience in designing such computing systems and applications. Each year, RACS brings together engineers and scientists from diverse communities with interests in practical computing technologies and creates an environment for them to exchange experimental results, novel designs, works-in-progress, experiences, case studies, and trend-setting ideas.}
}

@article{10.1145/3773035,
  author = {Yuan, Mingyue and Chen, Jieshan and Hu, Yongquan and Feng, Sidong and Xie, Mulong and Mohammadi, Gelareh and Xing, Zhenchang and Quigley, Aaron},
  title = {Towards Human–AI Synergy in UI Design: Supporting Iterative Generation with LLMs},
  journal = {ACM Trans. Comput.-Hum. Interact.},
  year = {2026},
  month = {feb},
  volume = {33},
  number = {1},
  pages = {1–45},
  numpages = {45},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3773035},
  url = {https://doi.org/10.1145/3773035},
  issn = {1073-0516},
  keywords = {Interactive design, User interface, Large language models, Image generation, Design intent clarification, Intent-design alignment, Automated prototype generation},
  abstract = {In automated UI design generation, a key challenge is the lack of support for iterative processes, as most systems focus solely on end-to-end output. This stems from limited capabilities in interpreting design intent and a lack of transparency for refining intermediate results. To better understand these challenges, we conducted a formative study that identified concrete and actionable requirements for supporting iterative design with Generative Tools. Guided by these findings, we propose PrototypeFlow, a human-centered system for automated UI generation that leverages multi-modal inputs and models. PrototypeFlow takes natural language descriptions and layout preferences as input to generate the high-fidelity UI design. At its core is a theme design module that clarifies implicit design intent through prompt enhancement and orchestrates sub-modules for component-level generation. Designers retain full control over inputs, intermediate results, and final prototypes, enabling flexible and targeted refinement by steering generation and directly editing outputs. Our experiments and user studies confirmed the effectiveness and usefulness of our proposed PrototypeFlow.}
}

@inproceedings{10.1145/3794786.3830777,
  author = {Andruccioli, Manuel and Nevo, Giovanni Del and Mirri, Silvia and Salomoni, Paola},
  title = {Agentic AI Meets User-Centered Design: Toward a Framework for Large Language Models as User Twins},
  booktitle = {Proceedings of the 2026 International Conference on Information Technology for Social Good},
  year = {2026},
  month = {oct},
  pages = {379–387},
  numpages = {9},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3794786.3830777},
  url = {https://doi.org/10.1145/3794786.3830777},
  isbn = {9798400724831},
  keywords = {Agentic AI, User-Centered Design, Large Language Models, User Twins, Human-AI Interaction},
  abstract = {User-Centered Design (UCD) relies on the active involvement of end users throughout the design process. However, in complex socio-technical domains, continuous user participation is often difficult to sustain due to time constraints, safety requirements, confidentiality issues, high workload, or limited access to operational environments. This conceptual paper proposes an Agentic UCD framework based on Large Language Model (LLM) User Twins (UTs) to address this user involvement gap. UTs are proposed as generative, interactive, adaptive, and agentic representations of target users or user groups, grounded in user research, domain knowledge, task descriptions, scenarios, and design constraints. Unlike traditional personas, which make user knowledge explicit but remain static, UTs can be queried, updated, and reused across design activities. Within the proposed framework, UTs support design exploration, implementation, synthetic evaluation, and preparation for human validation by acting as role-oriented agents that simulate user perspectives, critique design alternatives, generate scenarios, and identify potential usability, trust, workload, or accessibility issues. The paper emphasizes that UTs do not replace empirical user research, co-design, or usability testing. Their outputs should be treated as simulated feedback and design hypotheses, not as empirical evidence. Instead, UTs are positioned as a complementary mechanism for maintaining continuity in user-centered reasoning between moments of direct user involvement.}
}

@inproceedings{10.1145/3785987.3786027,
  author = {Li, Yang and Bao, Zilong},
  title = {Integrating AI Virtual Tutors in Blended Learning: A Controlled Evaluation of Learning Outcomes and Student Engagement},
  booktitle = {Proceedings of the 2025 2nd International Conference on Artificial Intelligence and Future Education},
  year = {2026},
  month = {jan},
  pages = {247–251},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3785987.3786027},
  url = {https://doi.org/10.1145/3785987.3786027},
  isbn = {9798400720956},
  keywords = {AI in Education, Blended Learning, GPT-4, Prompt Engineering, System Integration},
  abstract = {The integration of Artificial Intelligence (AI) into educational settings presents a transformative opportunity for personalized learning. This study investigates the efficacy of a state-of-the-art large language model (LLM), GPT-4, when deployed as an AI virtual tutor within a blended learning environment for an introductory programming course. Our technical contribution lies in the design and implementation of a robust, LMS-integrated tutoring interface, centered on a rigorously engineered system prompt to ensure pedagogical fidelity. We conducted a randomized controlled trial... Our findings suggest that leveraging advanced, off-the-shelf LLMs through careful system architecture and prompt engineering can create effective and scalable intelligent tutoring systems... The study provides a robust empirical framework and a reusable technical blueprint for the adoption of LLMs in real-world educational contexts.}
}

@inproceedings{10.1145/3805696.3846039,
  author = {Salsabil, Lamia and Obadage, Rochana R. and Banerjee, Bipasha and Alam, Sawood and Ingram, William and Fox, Edward and Wu, Jian},
  title = {End-to-End Contextualized URL Extraction from Scholarly Papers},
  booktitle = {Proceedings of the 26th ACM/IEEE Joint Conference on Digital Libraries},
  year = {2026},
  month = {oct},
  number = {Article 46},
  pages = {1–12},
  numpages = {12},
