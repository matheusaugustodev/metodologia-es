@book{10.1145/3586182,
  editor = {Follmer, Sean and Han, Jeff and Steimle, Jürgen and Riche, Nathalie Henry},
  title = {Adjunct Proceedings of the 36th Annual ACM Symposium on User Interface Software and Technology},
  series = {UIST '23 Adjunct},
