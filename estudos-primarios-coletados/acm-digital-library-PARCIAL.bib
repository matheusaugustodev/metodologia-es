@inproceedings{10.1145/3748522.3779941,
  author = {Manjunath, Vignesh and Pestana Puerta, Jesus and Scheipel, Tobias and Baunach, Marcel},
  title = {MiKB-RAG: A Microarchitecture Knowledge Base Framework for Embedded Software Development},
  booktitle = {Proceedings of the 41st ACM/SIGAPP Symposium on Applied Computing},
  year = {2026},
  month = {jun},
  pages = {643–652},
  numpages = {10},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3748522.3779941},
  url = {https://doi.org/10.1145/3748522.3779941},
  isbn = {9798400722943},
  keywords = {embedded software development, microarchitecture knowledge base, information retrieval, retrieval-augmented generation},
  abstract = {Embedded software developers extensively rely on microarchitecture documentation (e.g., datasheets and user manuals) to implement various functionalities, low-level device drivers, and Real-Time Operating System (RTOS). However, finding relevant information quickly and efficiently can be challenging and effort-intensive due to the large volume and distributed information throughout the documentation. To address this challenge, we present MiKB-RAG, a queryable microarchitecture knowledge base framework that leverages Retrieval-Augmented Generation (RAG) and a Large Language Model (LLM). As a proof of concept, we use our framework to construct knowledge bases for the AURIX TriCore TC27x and SiFive FE310 documentation, and evaluate the framework by analyzing the LLM-generated responses for semantic similarity and correctness (assessed through a scoring rubric). In our evaluation, we analyze how MiKB-RAG performs when implemented with six LLMs of varying model architectures and sizes. The results indicate that some models consistently produce relevant responses, while keeping the percentage of incorrect answers below 3.7\%. In addition, we observe that a smaller model with 8 billion parameters performs comparably to a larger model with 72 billion parameters. These findings demonstrate the suitability and effectiveness of MiKB-RAG for creating microarchitecture knowledge bases, and the potential of smaller LLMs for efficient information retrieval in this context.}
}

@inproceedings{10.1145/3786580.3786952,
  author = {Sha, Alyssa and Nunes, Bernardo Pereira and Chen, Yige},
  title = {FORGET-SE: A Controlled Dataset to Investigate Memory Decay and Interference in Software Engineering Knowledge Tracing},
  booktitle = {Proceedings of the IEEE/ACM 48th International Conference on Software Engineering},
  year = {2026},
  month = {jul},
  pages = {36–46},
  numpages = {11},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786580.3786952},
  url = {https://doi.org/10.1145/3786580.3786952},
  isbn = {9798400724237},
  keywords = {Knowledge Tracing, Educational Data Mining, Memory Decay, Interference Theory, Learning Analytics},
  abstract = {Forgetting is a fundamental aspect of human learning, yet existing Knowledge Tracing (KT) datasets fail to distinguish between two well-established forgetting mechanisms: memory decay (knowledge fades over time) and interference (new learning disrupts old knowledge). This limitation hinders researchers from developing accurate forgetting-aware models to trace students’ knowledge states and educators from understanding how teaching methodologies affect knowledge retention. This paper introduces FORGET-SE, the first controlled forgetting dataset collected from 186 university students (10,873 interactions) studying 10 software engineering knowledge components (KCs) (avg of 5.85 interactions per KC) through strategically sequenced weekly quizzes designed to assess memory decay and interference effects. State-of-the-art Deep Knowledge Tracing (DKT) models show significant performance degradation under interference, which opens new directions for advancing DKT. Finally, we outline research avenues that FORGET-SE can address beyond the traditional KT problem.}
}

