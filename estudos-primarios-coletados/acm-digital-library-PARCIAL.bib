@inproceedings{10.1145/3788910.3788939,
  author = {Wang, Kaizhen and Zhang, Huan and Niu, Shuai and Wang, Zhenhua and Sun, Jian and Chen, Cai},
  title = {An Intelligent Multi-Agent Framework for Automated Drafting and Compliance Optimization of Cadre Evaluation Materials},
  booktitle = {Proceedings of the 2025 International Conference on Digital Society and Intelligent Computing},
  year = {2026},
  month = {feb},
  pages = {196–202},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3788910.3788939},
  url = {https://doi.org/10.1145/3788910.3788939},
  isbn = {9798400719646},
  keywords = {cadre evaluation automation, compliance auditing, multi-agent drafting, semantic optimization},
  abstract = {In the domain of organizational management, the preparation of cadre evaluation reports remains a highly labor-intensive and error-prone process, constrained by inconsistent writing styles, insufficient semantic coherence, and the lack of systematic compliance checks. This paper proposes an intelligent multi-agent framework that automates the drafting and refinement of cadre evaluation materials. The framework consists of three core stages: semantic-level text optimization, multi-agent cooperative drafting, and polishing with compliance auditing. In the semantic optimization stage, sensitive information is identified and replaced with compliant expressions using a dynamic risk assessment model, while ambiguous or colloquial phrases are refined into formal and standardized terminology. The drafting stage employs template-matching and slot-filling mechanisms, coordinated by multiple writing agents to generate logically coherent and personalized reports. However, the system currently relies on simple cosine similarity and rule-based matching without a proper arbitration mechanism to resolve disagreements between agents. The system lacks an arbitration mechanism to resolve disagreements among agents. Finally, the polishing stage integrates language refinement with policy knowledge-graph-based auditing, ensuring the output meets organizational standards of accuracy, consistency, and policy compliance. Experimental analysis demonstrates that the proposed system significantly reduces manual workload while improving coherence, compliance, and efficiency, thus providing a scalable and intelligent solution for government and organizational evaluation tasks.}
}

@inproceedings{10.1145/3843782.3844652,
  author = {Kim, Jimin and Kang, Ho Jun and Lee, Jaehyun},
  title = {From Regulation to Innovation: Mining High-Impact AI Patents Grounded in the EU AI Act and Korea’s AI Basic Act},
  booktitle = {Proceedings of the 1st International Workshop on Trustworthy and Responsible aUtonomous SysTems},
