  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3843282},
  isbn = {9798400729850},
  abstract = {Welcome to the First International Workshop on Agentic AI for Next-Generation Software Development (AgenticDev 2026), held on October 12, 2026, in Munich, Germany, co-located with the IEEE/ACM International Conference on Automated Software Engineering (ASE 2026). The workshop brings together researchers and practitioners to explore how intelligent AI agents can collaborate with developers and one another throughout the software development lifecycle.}
}

@inproceedings{10.1145/3770855.3817556,
  author = {Yan, Jiaxian and Fang, Xi and Zhu, Jintao and Wu, Chenmin and Yang, Yuhang and Du, Chenxi and Fang, Meijing and Zhang, Kai and Zhang, Zaixi and Liu, Qi},
  title = {Benchmarking LLM Agents on Real-World Biological Database Curation for Data-Driven Scientific Discovery},
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
  year = {2026},
  month = {aug},
  pages = {10138–10149},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3770855.3817556},
  url = {https://doi.org/10.1145/3770855.3817556},
  isbn = {9798400722592},
  keywords = {biological database curation, large language model, agentic benchmark, scientific discovery},
  abstract = {High-quality biological databases are the bedrock of data-driven scientific discovery. However, the construction of these resources remains a labor-intensive bottleneck, particularly for emerging research frontiers where structured data is non-existent. While LLM-based agents have catalyzed progress in downstream scientific modeling, their potential to automate the critical upstream challenge of database curation remains largely untapped. To bridge this gap, we introduce BioDataLab, a rigorous benchmark comprising 100 tasks meticulously derived from 57 high-impact database publications. BioDataLab evaluates the capability of autonomous agents to transform raw, heterogeneous biological resources into structured, analysis-ready databases. Unlike static evaluations, BioDataLab provides a fully interactive environment encompassing data retrieval, extraction, annotation, and integration, featuring process-oriented curation targets and contamination-control checks. We benchmark 11 state-of-the-art LLMs (including Gemini-3.0, GPT-5.2, and Claude-4.5) under different agent frameworks, revealing a substantial capability gap: the top-performing model achieves only a 40\% success rate. Further error analysis identifies significant bottlenecks in multi-step tool orchestration and adherence to complex biological data formats. These findings underscore that while LLMs are proficient in downstream reasoning, autonomous upstream curation remains a formidable frontier. All data and codes are available at GitHub.}
}

@inproceedings{10.1145/3837062.3839552,
  author = {Elmouhi, Yassine},
  title = {Specializing Large-Language Models for Collaboration Workflow Generation in Software Engineering},
  booktitle = {Proceedings of the ACM/IEEE 29th International Conference on Model Driven Engineering Languages and Systems},
  year = {2026},
  month = {oct},
  pages = {41–45},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3837062.3839552},
  url = {https://doi.org/10.1145/3837062.3839552},
  isbn = {9798400729034},
  keywords = {large language models, multi-agent systems, workflow generation, SysML v2, software engineering},
  abstract = {Automated problem solving through teams of Large Language Model (LLM)-based agents has recently made remarkable progress, demonstrating the potential of collaborative approaches for software engineering tasks. Existing approaches generally follow one of two paradigms: they either solve tasks directly without generating an explicit collaboration workflow artifact, or they rely on simple lightweight collaboration artifacts. We hypothesize that generating expressive and formal collaboration workflow artifacts with rich control-flow semantics can improve the orchestration of specialized AI agents for complex software engineering tasks. This thesis investigates methods for specializing LLMs to automatically generate such workflow artifacts from natural language task descriptions. As a first step, we adopt SysML\&nbsp;v2 action flows as a formal workflow representation and construct a large-scale dataset of approximately 75,000 collaboration workflows by transforming heterogeneous workflow representations into SysML\&nbsp;v2 models. This dataset provides the foundation for specializing and evaluating LLMs on workflow generation tasks. Building on this work, the current research focuses on developing a benchmark for collaboration workflow generation and defining evaluation metrics that compare semantically equivalent workflows despite structural differences. The final objective of this thesis is to develop specialized LLMs capable of reliably generating formal collaboration workflow artifacts that orchestrate teams of AI agents for complex software engineering tasks.}
}

@article{10.1145/3797091,
  author = {Hong, Jongchan and Kim, Jaewon and Hwang, Sungjae},
  title = {OCPPuzz: Specification-Driven Fuzzing of Charging Station Management Systems with Large Language Model},
  journal = {Proc. ACM Softw. Eng.},
  year = {2026},
  month = {jun},
  volume = {3},
  number = {FSE},
  pages = {1404–1423},
  numpages = {20},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3797091},
  url = {https://doi.org/10.1145/3797091},
  keywords = {GPT, OCPP, automated validation, fuzzing, protocol testing},
  abstract = {Electric vehicles (EVs) are being rapidly adopted, with over 61,000 publicly accessible charging stations deployed across the United States as of 2024. A core component of this infrastructure is the Charging Station Management System (CSMS), which is responsible for security-critical tasks such as user authentication and billing. Given its importance, the CSMS has become a target of real-world attacks that have resulted in financial losses, data breaches, and denial-of-service (DoS) incidents. Nevertheless, research on CSMS security remains limited, and automated testing tools are lacking. Testing CSMS is challenging because they communicate with charging stations (CS) using the Open Charge Point Protocol (OCPP). Effective testing must contend with OCPP's complexity: 1) messages containing up to 48 fields, 2) inter- and intra-message field dependencies, and 3) its stateful nature, which requires tracking the states of both CS and CSMS during testing. To address these challenges, we present OCPPuzz, a specification-based fuzzing framework for CSMS. OCPPuzz automatically extracts message structures, field constraints, and dependency rules from the OCPP specification, as well as valid CS-CSMS state transitions described in its use case diagrams. To handle specifications expressed in natural language and semi-formal diagrams, OCPPuzz combines heuristic rule-based extraction with a large language model (LLM). We evaluated OCPPuzz on four open-source CSMS implementations and uncovered numerous deviations from the OCPP specification that led to critical security issues, including DoS and free charging. We reported 930 implementation bugs to the corresponding vendors, of which 492 have been acknowledged so far. In addition, we reported 155 specification bugs in OCPP to the Open Charge Alliance (OCA); 78 have been committed for fixes and 82 acknowledged for further investigation. We expect additional acknowledgments and fixes in the near future.}
}

@inproceedings{10.1145/3774904.3792993,
  author = {He, Haorui and Li, Yupeng and Wen, Dacheng and Chen, Yang and Cheng, Reynold and Chen, Donglong and Lau, Francis C. M.},
  title = {Debating Truth: Debate-driven Claim Verification with Multiple Large Language Model Agents},
  booktitle = {Proceedings of the ACM Web Conference 2026},
  year = {2026},
  month = {apr},
  pages = {8851–8861},
  numpages = {11},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3774904.3792993},
  url = {https://doi.org/10.1145/3774904.3792993},
  isbn = {9798400723070},
  keywords = {debate-driven claim verification, automated fact-checking},
  abstract = {State-of-the-art single-agent claim verification methods struggle with complex claims that require nuanced analysis of multifaceted evidence. Inspired by real-world professional fact-checkers, we propose DebateCV, the first debate-driven claim verification framework powered by multiple LLM agents. In DebateCV, two Debaters argue opposing stances to surface subtle errors in single-agent assessments. A decisive Moderator is then required to weigh the evidential strength of conflicting arguments to deliver an accurate verdict. Yet, zero-shot Moderators are biased toward neutral judgments, and no datasets exist for training them. To bridge this gap, we propose Debate-SFT, a post-training framework that leverages synthetic data to enhance agents' ability to effectively adjudicate debates for claim verification. Results show that our methods surpass state-of-the-art non-debate approaches in both accuracy (across various evidence conditions) and justification quality.}
}

@inproceedings{10.1145/3837062.3838900,
  author = {Ober, Iulian},
  title = {Can LLM agents with generic tools perform MBSE tasks, build-up skills and transfer them?},
  booktitle = {Proceedings of the ACM/IEEE 29th International Conference on Model Driven Engineering Languages and Systems},
  year = {2026},
  month = {oct},
  pages = {370–374},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3837062.3838900},
  url = {https://doi.org/10.1145/3837062.3838900},
  isbn = {9798400729034},
  abstract = {A Model-Based Systems Engineering (MBSE) model can be construed as a complex graph database, and this is true regardless of the underlying modeling language (SysML, SDL, Capella or indeed any Domain Specific Modeling Language). It is hence conceivable that an intelligent artificial agent, for example one based on a Large Language Model (LLM), may perform model-based tasks like creating or editing model elements using only generic CRUD (Create/Read/Update/Delete) tools, provided that these tools are made available through the Model Context Protocol (MCP), a tool-access protocol that most agents support. It is however not obvious that the agent can be effective at performing those model-based tasks, as MBSE models have to satisfy many internal coherence rules, some (or many) of which are not explicitly specified in language or tool manuals. This paper presents an experiment in building an MCP server for a complex MBSE environment (Capella) based on generic model access functions of the Eclipse Modeling Framework (EMF), evaluating the effectiveness of agents at learning how to use the MCP tools to perform a range of model editing tasks in Capella, and finally, evaluating the effectiveness of in-context transfer of the learned skills to other non-skilled agents.}
}

@article{10.1145/3859283,
  author = {Jeong, Hoyeon and Kim, Jindae},
  title = {An Empirical Analysis of LLM Usage in Software Engineering Course Projects},
  journal = {ACM Trans. Comput. Educ.},
  year = {2026},
  month = {oct},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3859283},
  url = {https://doi.org/10.1145/3859283},
  keywords = {Software Engineering Course Project, Large Language Models, Coding Agents},
  abstract = {Recent advancements in Large Language Models (LLMs) have had a substantial impact on software engineering research and practice, as well as on software engineering education. In Software Engineering (SE) education, prior studies have mainly examined students’ LLM usage through surveys, interviews, or short-term observations, offering limited visibility into their actual development activities. As a result, it remains unclear how students’ perceptions of LLM usage match their actual development practices.To address this gap, we analyze course project data collected over three years from 158 students enrolled in an upper-level SE course, together with students’ experience-sharing presentations, survey responses, and activity logs. We examine LLM integration by jointly analyzing students’ perceived usage and usefulness from surveys and presentations, their actual development activities captured through VS Code activity logs, and their project performance based on evaluation results across different levels of LLM support. By combining these analyses, we connect students’ reported LLM usage with their actual development activities and assess its relation to learning outcomes in SE course projects.Our results show that students utilized LLMs frequently for code-related tasks and generally found them helpful, with frequent usage increasing over the course project while perceptions shifted as project complexity grew. Activity log analysis revealed divergent patterns in LLM usage, reflecting both increasing dependency and deliberate efforts to maintain development independence. Across three years, integrating LLM support did not lead to statistically significant differences in final project achievement as measured by requirement satisfaction, although students with LLM support produced substantially larger software systems and lower-performing teams showed mild benefits, suggesting that LLMs may help reduce the influence of programming proficiency on project outcomes. Our findings highlight both the benefits and tensions of LLM integration in SE course projects and suggest that future SE course designs may incorporate more complex and challenging SE tasks beyond implementation-focused requirements, while also providing explicit education on prompt engineering, supporting students’ code comprehension of rapidly generated LLM-assisted code, and helping students avoid excessive dependency on LLM tools during development.}
}

