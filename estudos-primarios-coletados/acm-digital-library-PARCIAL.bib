@inproceedings{10.1145/3845354.3845458,
  author = {Liu, Mei and Wang, Mengxia and Wang, Junfeng and Guo, Shaochong and Yang, Jingyu and Liu, Yu and Wang, Yifan and Yi, Hao},
  title = {A Human-AI Collaborative Framework for Competency-Oriented Software Engineering Education: LLM-Assisted Practice, Learning Analytics, and Empirical Validation},
  booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
  year = {2026},
  month = {oct},
  pages = {632–638},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3845354.3845458},
  url = {https://doi.org/10.1145/3845354.3845458},
  isbn = {9798400723650},
  keywords = {Large language models, academic integrity, competency-oriented assessment, human-AI collaboration, learning analytics, software engineering education, teacher-in-the-loop validation},
  abstract = {Software engineering education requires students to coordinate requirements, UML models, architecture, code, tests, documentation, and defense evidence across a full project lifecycle. Delayed formative feedback often allows early requirement and modeling defects to propagate into implementation and testing. This paper proposes a human-AI collaborative framework for competency-oriented software engineering education. The framework embeds large language model (LLM) support into requirements feedback, UML diagnosis, code review, test-case ideation, process-data collection, learning analytics, and teacher-in-the-loop validation. In response to concerns about hallucination and academic misconduct, the revised framework incorporates explicit risk-control mechanisms, including restricted diagnostic prompts, mandatory AI-use logs containing prompts and raw LLM outputs, cross-artifact verification with code-quality and test-coverage tools, rubric-based teacher validation, and defensive oral questioning during project defense. A 16-week quasi-experiment was conducted with 122 undergraduate software engineering students: 62 in an experimental group using the LLM-assisted framework and 60 in a control group using conventional instructor-reviewed project-based learning. The experimental group significantly outperformed the control group on  (M1  )- (M6  ),  (M8  ), and  (M9  ) indicators (all  (p  \&lt;   0.001  )), with effect sizes from  (d  =   0.706  ) to  (d  =   1.026  ). The largest gains appeared in competency achievement, code quality, test-case completeness, and design-code consistency. The findings suggest that LLM support is educationally valuable only when it is embedded in a transparent, evidence-based, and human-verified workflow rather than used as an unrestricted automation tool.}
}

