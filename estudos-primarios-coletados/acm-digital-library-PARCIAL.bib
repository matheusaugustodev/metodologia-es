@book{10.1145/3841644,
  title = {Proceedings of the 2026 ACM SIGPLAN International Symposium on SPLASH-E},
  series = {SPLASH-E '26},
  year = {2026},
  month = {sep},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3841644},
  isbn = {9798400729492},
  abstract = {Welcome to the SPLASH-E 2026, the SPLASH community’s annual symposium on software engineering and programming languages in education! Programming languages are fundamental tools used throughout computer science curricula, and so it is fruitful to encourage regular dialog between the programming language community and the CS education community. This inter- section can involve teaching practice, teaching languages, teaching philosophy and teaching practicalities. We are happy that SPLASH-E continues to exist as a space for these conversations, especially at a time when computer science education is deeply impacted by the widespread arrival of code agents. This year we have papers that cover topics from teaching Hoare Logic to using LLMs to generating semantic mutants for grading, and span visualization of Turing machines or dependent types and proofs. We continue to be excited by the variety of papers and different approaches that SPLASH-E allows to occur, and hope that there will be lively conversations at the symposium, not limited only to the topics of the papers, or only among the attendees, but with the larger SPLASH community. We received 6 archival submissions and 5 non-archival submissions. We ac- cepted 4 of the archival submissions for publication, and all 5 non-archival submis- sions for presentation at the symposium. A program committee of 10 provided 16 reviews. Reviewers were instructed to consider the intellectual contribution, the ability for lessons to be re-used, and the clarity of argument. We are very happy with the quality of work that will be presented, and excited the conversations it will be sure to spark.}
}

@inproceedings{10.1145/3805621.3807649,
  author = {Leon, Agustin and Niroula, Anup and Fund, Fraida},
  title = {OpenMCP: an open-source self-hosted benchmarking harness for MCP-enabled computer use agents},
  booktitle = {Proceedings of the Sixth European Workshop on Machine Learning and Systems},
  year = {2026},
  month = {apr},
  pages = {456–465},
  numpages = {10},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3805621.3807649},
  url = {https://doi.org/10.1145/3805621.3807649},
  isbn = {9798400726057},
  keywords = {Model Context Protocol, computer use agents, large language models, evaluation harness, open source},
  abstract = {The Model Context Protocol (MCP) standardizes how language models connect to external tools and applications, yet existing MCP benchmarks rely on externally hosted LLMs, constraining reproducibility and limiting observable metrics and privacy control. We present OpenMCP, an open-source, self-hosted benchmarking harness for MCP-enabled computer-use agents. Models are served locally via Ollama in Docker containers, giving researchers control over model versions, hardware, and serving configuration. This enables collection of metrics for task completion (success rate, key-step progress), efficiency (energy, GPU utilization, memory), and agent issues (hallucinations, tool-choice confidence, loops). OpenMCP follows a bring-your-own approach: researchers supply models, infrastructure, MCP servers, and tasks, while the harness handles scheduling, isolation, evaluation, and telemetry. We demonstrate OpenMCP on 19 models across 5 families and 6 infrastructure configurations, from datacenter GPUs to edge devices. Code and data are available at https://github.com/AguLeon/OpenMCP.}
}

@inproceedings{10.1145/3800424.3800437,
  author = {Aljedaani, Wajdi and Ammar, Ahmad and Alkadi, Hamad and Alyamani, Hamzah and Mamdoh, Abdulrhman},
  title = {Clarity: An AI-Powered Tool for Stuttering Detection and Fluency Tracking},
  booktitle = {Proceedings of the 23rd International Web for All Conference},
  year = {2026},
  month = {jun},
  pages = {144–146},
  numpages = {3},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3800424.3800437},
  url = {https://doi.org/10.1145/3800424.3800437},
  isbn = {9798400723728},
  keywords = {Stuttering, Accessibility, Artificial Intelligence, Speech Disorder.},
  abstract = {Individuals who stutter often face challenges when practicing speech, building confidence, and improving fluency during spoken communication. To address these challenges, we present Clarity, a speech analysis tool designed to help users identify moments of stuttering in their speech. Clarity analyzes spoken audio in short segments and provides clear feedback on where stuttering occurs, allowing users to better understand their speaking patterns. Designed to support speech practice and public speaking preparation, Clarity offers an automated and easy-to-use solution that helps users track fluency and make meaningful improvements over time. Our approach suggests that Clarity provides a practical and effective way to support speech practice and self-guided fluency improvement.}
}

@inproceedings{10.1145/3788149.3788219,
  author = {Tereshchenko, Sergei N. and Shchedrov, Artem V.},
  title = {A Software Synapse for a Multi-Agent System Based on Large Language Models},
  booktitle = {Proceedings of the 2025 9th International Conference on Computer Science and Artificial Intelligence},
  year = {2026},
  month = {mar},
  pages = {700–707},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3788149.3788219},
  url = {https://doi.org/10.1145/3788149.3788219},
  isbn = {9798400719622},
  keywords = {agent lifecycle management, biologically inspired architecture, large language models, multi-agent systems, software synapse},
  abstract = {Multi-agent systems (MAS) built on agents using large language models (LLMs) are considered a promising approach for solving complex problems. In this study, agent interaction is analyzed through the lens of the structure of synapses connecting neurons in the human brain. Based on the principles of neurotransmitters and synaptic transmission, we develop a simplified model of a biological synapse. The main focus is on creating a task distribution mechanism using a signal broker and controlling the lifecycle of connections between agents, similar to the functioning of neurotransmitters. The final part of the work shows the results of applying this mechanism and raises questions for further research and discussion in the field of LLM-based multi-agent systems using this approach. This method opens the way to the development of more adaptive and integrated artificial intelligence systems.}
}

@inproceedings{10.1145/3770855.3818639,
  author = {Huan, Jun and Caverlee, James and Li, Lei and Lingam, Vijay},
  title = {KDD AI reasoning day},
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
  year = {2026},
  month = {aug},
  pages = {13463–13464},
  numpages = {2},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3770855.3818639},
  url = {https://doi.org/10.1145/3770855.3818639},
  isbn = {9798400722592},
  keywords = {ai reasoning, llm},
  abstract = {Large language models and foundation models are increasingly embedded in reasoning systems that plan, invoke tools, use memory, gather evidence, and iteratively refine their outputs. The second KDD Day on AI Reasoning brings together researchers and practitioners from academia and industry to examine how these systems can be made more capable, reliable, interpretable, and efficient. The program spans scientific discovery, human-centered interaction, software engineering, time-series analysis, deep research, computer use, and inference infrastructure. Across these domains, the day highlights shared challenges: grounding decisions in evidence, designing effective feedback and verification mechanisms, evaluating open-ended behavior, managing test-time computation, and preserving meaningful human control. Through keynote and invited presentations, the event provides a forum for connecting advances in models, agents, data, systems, and applications, and for identifying research directions toward trustworthy next-generation reasoning systems.}
}

@inproceedings{10.1145/3795101.3814729,
  author = {Pantridge, Edward and Helmuth, Thomas},
  title = {Diagnosing Problems with the Code Building Genetic Programming Representation},
  booktitle = {Proceedings of the Genetic and Evolutionary Computation Conference Companion},
  year = {2026},
  month = {aug},
  pages = {1511–1519},
  numpages = {9},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3795101.3814729},
  url = {https://doi.org/10.1145/3795101.3814729},
  isbn = {9798400724886},
  keywords = {genetic programming, representation, locality, redundancy},
  abstract = {Code Building Genetic Programming (CBGP) produces type-safe programs supporting higher-order functions and polymorphism, yet consistently under-performs other GP approaches on program synthesis benchmarks. Rather than proposing another targeted fix, we ask why CBGP struggles. Through empirical experiments, we identify three interrelated failure modes: the CBGP representation exhibits low locality and high redundancy leading to poor inheritability of phenotypical traits, evolutionary lineages fail to explore the space of programs effectively, and genome compilation accumulates deep stacks of tiny abstract syntax trees causing search to cycle over a relative small set of programs. We conclude that the compilation algorithm, as well as its interactions with the genetic representation and genetic operators, is the primary obstacle to effective search.}
}

@inproceedings{10.1145/3786175.3788349,
  author = {Ackerman, Samuel and Ibraheem, Wesam and Raz, Orna and Zalmanovici, Marcel},
  title = {Evaluating perturbation robustness of generative systems that use COBOL code inputs},
  booktitle = {Proceedings of the 1st International Workshop on AI for Software Quality Evaluation - Judgment, Metrics, Benchmarks, and Beyond},
  year = {2026},
  month = {jul},
  pages = {72–87},
  numpages = {16},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786175.3788349},
  url = {https://doi.org/10.1145/3786175.3788349},
  isbn = {9798400724077},
  keywords = {COBOL, perturbation, LLMs, generative models, robustness, code translation},
  abstract = {Systems incorporating large language models (LLMs) as a component are known to be sensitive (i.e., non-robust) to minor input variations that do not change the meaning of the input; such sensitivity may reduce the system’s usefulness. Here, we present a framework to evaluate robustness of systems using COBOL code as input; our application is translation between COBOL and Java programming languages, but the approach extends to other tasks such as code generation or explanation. Targeting robustness of systems with COBOL as input is essential yet challenging. Many business-critical applications are written in COBOL, yet these are typically proprietary legacy applications and their code is unavailable to LLMs for training. We develop a library of COBOL paragraph and full-program perturbation methods, and create variant-expanded versions of a benchmark dataset of examples for a specific task. The robustness of the LLM-based system is evaluated by measuring changes in values of individual and aggregate metrics calculated on the system’s outputs. Finally, we present a series of dynamic table and chart visualization dashboards that assist in debugging the system’s outputs, and monitoring and understanding root causes of the system’s sensitivity to input variation. These tools can be further used to improve the system by, for instance, indicating variations that should be handled by pre-processing steps.}
}

@inproceedings{10.1145/3772318.3791673,
  author = {Feng, K. J. Kevin and Pu, Kevin and Latzke, Matt and August, Tal and Siangliulue, Pao and Bragg, Jonathan and Weld, Daniel S and Zhang, Amy X. and Chang, Joseph Chee},
  title = {Cocoa: Co-Planning and Co-Execution with AI Agents},
  booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
  year = {2026},
  month = {apr},
  number = {Article 16},
  pages = {1–23},
  numpages = {23},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3772318.3791673},
  url = {https://doi.org/10.1145/3772318.3791673},
  isbn = {9798400722783},
  abstract = {As AI agents take on increasingly long-running tasks involving sophisticated planning and execution, there is a corresponding need for novel interaction designs that enable deeper human-agent collaboration. However, most prior works leverage human interaction to fix “autonomous” workflows that have yet to become fully autonomous or rigidly treat planning and execution as separate stages. Based on a formative study with 9 researchers using AI to support their work, we propose a design that affords greater flexibility in collaboration, so that users can 1) delegate agency to the user or agent via a collaborative plan where individual steps can be assigned; and 2) interleave planning and execution so that plans can adjust after partial execution. We introduce Cocoa, a system that takes design inspiration from computational notebooks to support complex research tasks. A lab study (n = 16) found that Cocoa enabled steerability without sacrificing ease-of-use, and a week-long field deployment (n = 7) showed how researchers collaborated with Cocoa to accomplish real-world tasks.}
}

@inbook{10.1145/3793302.3793355,
  author = {Opdebeeck, Ruben and Alfadel, Mahmoud and Rahman, Akond and Kashiwa, Yutaro and Ferreira, João F. and Kula, Raula Gaikovina and De Roover, Coen},
  title = {An Empirical Study of Policy as Code: Adoption, Purpose, and Maintenance},
  booktitle = {Proceedings of the 23rd International Conference on Mining Software Repositories},
  year = {2026},
  month = {jul},
  pages = {249–261},
  numpages = {13},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3793302.3793355},
  url = {https://doi.org/10.1145/3793302.3793355},
  isbn = {9798400724749},
  abstract = {Policy as Code (PaC) is an emerging DevOps practice that enables teams to specify organisational and technical policies, such as regulatory compliance, security requirements, and resource limits, through machine-enforceable declarative code. As PaC gains prominence, practitioners face difficulties in adopting PaC while there remains a limited empirical understanding of how these policies are introduced, what types can be expressed, and how they are maintained in practice. This paper aims to address this gap through an empirical study of PaC based on 10,560 PaC files from 499 open-source repositories spanning nine PaC tools. We find that PaC is introduced throughout all phases of repository lifecycles, often co-occurring with IaC tools such as Kubernetes or Terraform, with most repositories adopting one of five policy enforcement strategies. Our taxonomy of 12 policy categories reveals that while most policies govern infrastructures and security requirements, they can also express broader constraints related to software development, intellectual property, and expenses. We observe that PaC files are maintained through infrequent yet often substantial changes. Most changes concern refactoring, yet when policy behaviour does change, policies tend to become stricter rather than more lenient. These findings motivate and support wider and earlier adoption of PaC tools. To this end, the taxonomy of policy categories can serve as a reference to practitioners to identify use cases for PaC in their projects. Meanwhile, our catalogue of enforcement strategies, co-occurring IaC tools, and PaC tool coverage of the taxonomy can inform practitioners when deciding which PaC tool to adopt and how to integrate it in their projects. Finally, our findings motivate future research to automate PaC file generation and maintenance.}
}

@inproceedings{10.1145/3830398.3830558,
  author = {Matsuyama, Hitoshi and Higuchi, Keita},
  title = {DocuDebug: A Graph-Supported Interactive Editor for Verifying and Maintaining Internal Logical Consistency},
  booktitle = {Proceedings of the 39th Annual ACM Symposium on User Interface Software and Technology},
  year = {2026},
  month = {nov},
  number = {Article 15},
  pages = {1–17},
  numpages = {17},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3830398.3830558},
  url = {https://doi.org/10.1145/3830398.3830558},
  isbn = {9798400728563},
  keywords = {Large Language Models, human-AI interaction},
  abstract = {While large language models (LLMs) accelerate report generation, maintaining logical consistency during revisions increases the cognitive load, and delegating this task to LLMs often results in unpredictable global overwrites. To address this, we present DocuDebug, an interactive editor that reframes document verification as a software engineering task. The system models a document’s logical structure and citations as an explicit dependency graph. Through a linter-like interface, users receive real-time warnings for logical conflicts and propagate localized edits with guided precision. In a within-subjects study with 12 professional writers, DocuDebug guided precise, necessary corrections, improving precision over threefold and reducing over-editing from over 40\% to under 5\%. Furthermore, objective logs revealed that users avoided blind acceptance, actively deliberating over each warning for nearly three minutes. This work demonstrates how structured visual diagnostics can shift AI-assisted writing from opaque global generation to systematic, user-controlled co-creation.}
}

@inproceedings{10.1145/3837062.3840557,
  author = {White, Lindsay and Raoul-Duval, Hugo and Paige, Richard and Geiskkovitch, Denise and Mosser, Sebastien},
  title = {A Model-Based Approach to Security Assessment of Robotic Systems in Healthcare: The Case of a Quadruped Robot},
  booktitle = {Proceedings of the ACM/IEEE 29th International Conference on Model Driven Engineering Languages and Systems},
  year = {2026},
  month = {oct},
  pages = {813–822},
  numpages = {10},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3837062.3840557},
  url = {https://doi.org/10.1145/3837062.3840557},
  isbn = {9798400729034},
  abstract = {Robotic systems are increasingly being adopted in healthcare environments such as rehabilitation centres, in order to help support overburdened staff by performing more routine tasks. However, deploying a robot in a clinical setting introduces security risks that must be assessed before use. Small facilities rarely have access to the specialised expertise or budget needed to perform a full cybersecurity audit, and existing approaches to security analysis rely heavily on the expert knowledge of the analyst. We propose a model-based security analysis approach that assists non-experts in assessing the security of a deployed system. The approach guides non-experts in creating attack trees using both generic guidewords, as well as guidewords that are derived from system models. Additionally, an LLM is used to act as a security expert team member in the attack tree creation process. We have a security expert create a prompt template as a one-time activity, so that non-experts only need to fill in specific information on the system in order to get an attack tree output by the LLM. We use an example scenario of a Unitree Go2 Air robot dog deployed in a rehabilitation centre to demonstrate various aspects of our approach. We show initial steps towards creating a prompt template for the LLM, and show the usefulness of both the generic and model-based guidewords in creating more relevant attack trees by non-experts.}
}

@inproceedings{10.1145/3803291.3803376,
  author = {Zago, Cassiano Darif and de Mendonça, Fábio Lúcio Lopes and Nze, Georges D. Amvame and Gondim, João José Costa and Albuquerque, Robson De Oliveira and Torres, Jorge Osvaldo A. Lima},
  title = {RepoGuard: Harmonising Security and Functional Correctness in LLM-Guided Repository-Level Code Generation},
  booktitle = {Proceedings of the 2026 9th International Conference on Information and Computer Technologies},
  year = {2026},
  month = {jun},
  pages = {378–386},
  numpages = {9},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3803291.3803376},
  url = {https://doi.org/10.1145/3803291.3803376},
  isbn = {9798400722523},
  keywords = {Large Language Models, Code Generation, Static Analysis, Automated Repair, Software Security, RCI},
  abstract = {The rapid adoption of Large Language Models (LLMs) for code generation has significantly enhanced developer productivity while simultaneously increasing the risk of introducing insecure or functionally incorrect code into software repositories. This paper presents RepoGuard-Agent, an orchestration architecture that integrates LLM-driven repair with deterministic program analysis to automatically generate safer, compilable patches for vulnerable code. RepoGuard combines context retrieval (via AST-based repository analysis), prompt-engineered LLM correction, an Auto-Importer post-processor, and a hybrid validation oracle comprising ensemble Static Application Security Testing (SAST) scanners and dynamic unit tests. The proposed pipeline prioritises in-context learning and agent orchestration over resource-intensive fine-tuning, thereby reducing infrastructure overhead while maintaining practical robustness. Evaluation on a synthetic multi-CWE script demonstrates that RepoGuard converges to a safer, functionally correct solution within Recursive Criticism and Improvement (RCI) iterations, successfully mitigating security vulnerabilities without compromising functionality. Results highlight the critical role of AST-based import repair and ensemble validation in addressing LLM scope myopia and static analyser noise. Finally, limitations, human-in-the-loop policies, and integration pathways for CI/CD deployment are discussed.}
}

@article{10.1145/3845810,
  author = {Colonnese, Valerio and Manfredi, Gilda and Capece, Nicola and Ungaro, Salvatore and Erra, Ugo},
  title = {Design and Evaluation of an LLM-Powered Virtual Guide for Rupestrian Churches Using XR Technologies},
  journal = {J. Comput. Cult. Herit.},
  year = {2026},
  month = {oct},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3845810},
  url = {https://doi.org/10.1145/3845810},
  issn = {1556-4673},
  keywords = {Extended Reality, Large Language Models, Retrieval-Augmented Generation, Conversational Agents, Cultural Heritage, Multimodal Systems, Grounding Evaluation, Human–AI Alignment},
  abstract = {In recent years, Large Language Models (LLMs) have begun to find application in immersive Extended Reality (XR) environments, raising questions regarding their reliability, grounding, and evaluation in multimodal interaction, especially with Cultural Heritage (CH) contents. To address these challenges, this work presents the design and systematic assessment of an Large Language Model (LLM)-powered virtual guide for rupestrian churches in Matera, implemented within a high-fidelity immersive eXtended Reality (XR) application. The system combines speech transcription, visual object detection, spatial contextualization, and Retrieval-Augmented Generation (RAG) to deliver context-aware responses grounded in curated Cultural Heritage (CH) knowledge. Beyond system implementation, the study frames the XR application as a controlled experimental platform to investigate the causal impact of retrieval augmentation on response quality, grounding fidelity, robustness, and stability. To isolate this effect, a paired RAG ON/OFF design was adopted across multiple large-scale language models (70B–120B parameters), enabling within-query comparisons under identical prompting and decoding conditions. We evaluated the system using a hybrid methodology that integrates automated retrieval-aware metrics (Retrieval Augmented Generation Assessment (RAGAS)) with a blind expert assessment by domain specialists in medieval archaeology. Results demonstrate that retrieval augmentation yields statistically robust improvements in grounding-related metrics, particularly faithfulness and factual correctness, and significantly increases expert-rated accuracy, completeness, coherence, clarity, and overall acceptability. Correlation and delta-based alignment analyses reveal selective convergence between automated metrics and human judgments, highlighting answer relevancy as the most human-aligned diagnostic signal in immersive CH contexts. Stability analyses further indicate that RAG improves epistemic grounding without introducing additional generative variability. These findings support retrieval augmentation as a structural mechanism to enhance reliability in XR-based CH applications and provide a replicable framework for evaluating grounded conversational intelligence in multimodal settings.}
}

@inproceedings{10.1145/3786155.3788582,
  author = {Loose, Nils and Winkel, Nico and Hempel, Kristoffer and Mächtle, Felix and Hans, Julian and Eisenbarth, Thomas},
  title = {Coverage-Guided Multi-Agent Harness Generation for Java Library Fuzzing},
  booktitle = {Proceedings of the 19th ACM/IEEE International Workshop on Search-Based and Fuzz Testing},
  year = {2026},
  month = {jul},
  pages = {36–43},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786155.3788582},
  url = {https://doi.org/10.1145/3786155.3788582},
  isbn = {9798400723872},
  keywords = {fuzzing, harness generation, large language models, multi-agent systems, coverage-guided testing, program analysis, Java},
  abstract = {Coverage-guided fuzzing has proven effective for software testing, but targeting library code requires specialized fuzz harnesses that translate fuzzer-generated inputs into valid API invocations. Manual harness creation is time-consuming and requires deep understanding of API semantics, initialization sequences, and exception handling contracts. We present a multi-agent architecture that automates fuzz harness generation for Java libraries through specialized LLM-powered agents. Five ReAct agents decompose the workflow into research, synthesis, compilation repair, coverage analysis, and refinement. Rather than preprocessing entire codebases, agents query documentation, source code, and callgraph information on demand through the Model Context Protocol, maintaining focused context while exploring complex dependencies. To enable effective refinement, we introduce method-targeted coverage that tracks coverage only during target method execution to isolate target behavior, and agent-guided termination that examines uncovered source code to distinguish productive refinement opportunities from diminishing returns. We evaluated our approach on seven target methods from six widely-deployed Java libraries totaling 115,000+ Maven dependents. Our generated harnesses achieve a median 26\% improvement over OSS-Fuzz baselines and outperform Jazzer AutoFuzz by 5\% in package-scope coverage. Generation costs average $3.20 and 10 minutes per harness, making the approach practical for continuous fuzzing workflows. During a 12-hour fuzzing campaign, our generated harnesses discovered 3 bugs in projects that are already integrated into OSS-Fuzz, demonstrating the effectiveness of the generated harnesses.}
}

@inproceedings{10.1145/3772318.3791323,
  author = {Mayahi, Shiva and Alomar, Noura and Malkin, Nathan},
  title = {Tinker, Tailor, Trust: How Developers Create Privacy Policies With and Without AI},
  booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
  year = {2026},
  month = {apr},
  number = {Article 1207},
  pages = {1–19},
  numpages = {19},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3772318.3791323},
  url = {https://doi.org/10.1145/3772318.3791323},
  isbn = {9798400722783},
  keywords = {mobile developer, privacy policy, LLM, AI, usable privacy},
  abstract = {For mobile developers to comply with privacy regulations, they must create privacy policies that accurately describe their apps’ data practices. This requires a complete understanding of their apps’ behaviors, including those of embedded third-party SDKs. Despite the complexity of this process, little is known about how privacy policies are created and validated. To investigate, we interviewed 20 developers from around the world about their processes, also observing them use a large language model (LLM) to prepare privacy policies for their apps. We found that developers struggle with collecting information about third-party SDKs, even when they use LLMs, and feel uncertain about the legal validity of LLM outputs. Many developers do not seek legal assistance and believe that, as long as app stores accept their privacy policies, they are protected. Our findings suggest that reliance on LLMs and developers’ desire to externalize validation may result in increasingly unreliable privacy policies.}
}

@article{10.1145/3810943,
  author = {Zhao, Yihang and Kurteva, Anelia and Meroño-Peñuela, Albert and Simperl, Elena},
  title = {OntoChat Assistant for User Story Generation in Ontology Engineering},
  journal = {ACM Trans. Intell. Syst. Technol.},
  year = {2026},
  month = {jun},
  volume = {17},
  number = {4},
  pages = {1–27},
  numpages = {27},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3810943},
  url = {https://doi.org/10.1145/3810943},
  issn = {2157-6904},
  keywords = {ontology engineering, knowledge engineering, large language models, interface design, interaction designs, requirements elicitation, prompt guidance, conversational agents, user story generation, narrative generation, participatory prompting, knowledge graphs, prompt engineering, usability evaluation, user story, OntoChat},
  abstract = {An ontology is a formal, explicit specification of a shared conceptualisation, which can be combined with problem-solving methods and reasoning functionality to develop high-quality technology and application systems efficiently. Ontology engineering typically involves extensive manual effort to elicit intended use cases (user stories) from users for the target ontology-based systems. Recent studies have demonstrated the positive potential of large language model-based conversational agents in supporting user story generation in OE. However, we argue that we are not leveraging LLM to its fullest potential by not supporting users in formulating effective prompts. To address this, we identify the prompt guidance users need during user story generation workflows by conducting a formative study (N = 10) using participatory prompting. We demonstrate its usefulness through the design and development of the OntoChat LLM-based system for OE, as well as a user evaluation with knowledge engineers (N = 24). To our knowledge, this is the first work to design and validate a prompt guidance framework that helps users leverage LLM to its fullest potential to generate effective requirements for ontology development. This advances how we interact with LLM for requirements elicitation.}
}

@inproceedings{10.65109/WTIF5096,
  author = {Garimella, Ritvik and Stewart, Michael Charles and Do, Kevin and Israel, Leeon and Sheth, Amit},
  title = {KiMO: Knowledge-infused Multi-agent Orchestrator},
  booktitle = {Proceedings of the 25th International Conference on Autonomous Agents and Multiagent Systems},
  year = {2026},
  month = {may},
  pages = {4152–4154},
  numpages = {3},
  publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
  address = {Richland, SC},
  doi = {10.65109/WTIF5096},
  url = {https://doi.org/10.65109/WTIF5096},
  isbn = {9798400723179},
  keywords = {multi-agent orchestration, workflow construction, heterogeneous agents},
  abstract = {Multi-Agent Systems (MAS) provide a natural paradigm for solving complex problems requiring coordinated, multi-step reasoning and decision making. As these systems scale, effective agentic orchestration becomes crucial. While existing tools such as AgentFlow and Agent Development Kit (ADK) support agent communication and task delegation, they remain limited in understanding task semantics, coordinating heterogeneous agent types (e.g., reactive vs. cognitive), and aligning agent selection with domain knowledge and infrastructure constraints. We present KiMO, a knowledge-infused multi-agent orchestrator that makes coordination explicit through structured knowledge infusion: planning ontologies encode domain-specific task decompositions, and agent registries formalize capabilities and compatibility constraints for heterogeneous components. KiMO operationalizes these through a two-stage pipeline: ontology-guided sub-task planning (PlanGen) and registry-guided workflow assembly (AgentGen). This dual knowledge infusion enables interpretable, flexible orchestration with human-inspectable coordination decisions. Our interactive platform demonstrates real-time workflow construction for manufacturing pipelines with expert refinement and dynamic knowledge extension. Code is available at https://tinyurl.com/3es9zyhj and Demo Video at https://tinyurl.com/yfa8ctwn.}
}

