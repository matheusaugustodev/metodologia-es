  url = {https://doi.org/10.1145/3788550.3794865},
  isbn = {9798400724459},
  keywords = {Root Cause Analysis, Self-Adaptive System, Multi-modal data, Agent, Large Language Model, Microservice System},
  abstract = {This artifact provides the necessary code, scripts, and data to reproduce the main experimental results of the paper Dynamic Agent Generation for Self-Adaptive Root Cause Analysis accepted to SEAMS 2026. It includes the implementation of the Parser and Executor agents, configuration files for all evaluated settings, and preprocessed observability data derived from the Nezha and OpenRCA benchmarks. The goal of this artifact is to ensure that the reported results are transparent and verifiable, supporting the claims for the “Artifact Available”, “Artifact Functional”, and “Artifact Reusable” badges.}
}

@inbook{10.1145/3793302.3793348,
  author = {Ahmed, Sadif and Rahman, Md Nafiu and Wahab, Zahin and Uddin, Gias and Shahriyar, Rifat},
  title = {Secret Leak Detection in Software Issue Reports using LLMs: A Comprehensive Evaluation},
  booktitle = {Proceedings of the 23rd International Conference on Mining Software Repositories},
  year = {2026},
  month = {jul},
  pages = {169–180},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3793302.3793348},
  url = {https://doi.org/10.1145/3793302.3793348},
  isbn = {9798400724749},
  abstract = {In the digital era, accidental exposure of sensitive information such as API keys, tokens, and credentials is a growing security threat. While most prior work focuses on detecting secrets in source code, leakage in software issue reports remains largely unexplored. This study fills that gap through a large-scale analysis and a practical detection pipeline for exposed secrets in GitHub issues. Our pipeline combines regular expression–based extraction with large language model (LLM)–based contextual classification to detect real secrets and reduce false positives. We build a benchmark of 54,148 instances from public GitHub issues, including 5,881 manually verified true secrets. Using this dataset, we evaluate entropy-based baselines and keyword heuristics used by prior secret detection tools, classical machine learning, deep learning, and LLM-based methods. Regex and entropy based approaches achieve high recall but poor precision, while smaller models such as RoBERTa and CodeBERT greatly improve performance (F1 = 92.70\%). Proprietary models like GPT-4o perform moderately in few-shot settings (F1 = 80.13\%), and fine-tuned open-source larger LLMs such as Qwen and LLaMA reach up to 94.49\% F1. Finally, we also validate our approach on 178 real-world GitHub repositories, achieving an F1-score of 81.6\% which demonstrates our approach’s strong ability to generalize to in-the-wild scenarios.}
}

@inproceedings{10.1145/3803437.3807389,
  author = {Satter, Abdus and Panta, Shishir and Baggili, Ibrahim},
  title = {Bounded Orchestration for LLM-Assisted Memory Snapshot Triage},
  booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
  year = {2026},
  month = {jul},
  pages = {1410–1411},
  numpages = {2},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3803437.3807389},
  url = {https://doi.org/10.1145/3803437.3807389},
  isbn = {9798400726361},
  keywords = {memory snapshot analysis, large language models, agentic AI},
  abstract = {Memory snapshots are often the only reliable runtime artifact available after severe system failures, injected malicious activity, or suspected compromise, yet their analysis remains manual and tool-intensive. We present a bounded state-machine orchestration framework that integrates a large language model (LLM) as a planner within a controlled plan→execute→finalize process over schema-defined diagnostic primitives. The design enforces explicit control flow, schema-validated tool invocation, decoupled execution, and projection-based context reduction to stabilize multi-step reasoning over large runtime artifacts. Evaluated on three Windows memory snapshots, including one controlled benign workload and two real-world malware samples, using 45 investigation queries, the framework achieves 82.9\% correct and grounded responses on positive queries and 100\% correctness on negative queries, while reducing tool-output size by up to 89\%. It also identifies two real-world malware samples within the experimental memory snapshots.}
}

