  numpages = {6},
  publisher = {Usability Professionals' Association},
  address = {Bloomingdale, IL},
  doi = {10.5555/3799939.3799940},
  issn = {1931-3357},
  abstract = {User Experience, as a profession, is having a moment—a really uncomfortable moment. After years of exponential growth culminating in countless boot camps, university programs, TED Talks™, and more, the seemingly endless number of job offerings dried up. Between 2022 and 2023, the UX profession saw a drop of almost 71\% in job listings (Brookshier, 2023). That's a huge drop in demand for what had been, up to that point, a booming profession! What happened? As any good engineer will tell you: It's complicated.}
}

