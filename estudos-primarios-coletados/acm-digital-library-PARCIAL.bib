@inproceedings{10.1145/3755881.3755893,
  author = {Ling, Feng and Huang, Guoheng and Wang, Jingchao and Yuan, Xiaochen and Chen, Xuhang and Zhang, XueYong and Zhang, Fanlong and Pun, Chi-Man},
  title = {Code Retrieval with Mixture of Experts Prototype Learning Based on Classification},
  booktitle = {Proceedings of the 16th International Conference on Internetware},
  year = {2025},
  month = {oct},
  pages = {47–58},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3755881.3755893},
  url = {https://doi.org/10.1145/3755881.3755893},
  isbn = {9798400719264},
  keywords = {Prototype Learning, Mixture of Experts, Code Retrieval},
  abstract = {The semantic connection between code and queries is crucial for code retrieval, but many human-written queries fail to accurately capture the code’s core intent, leading to ambiguity. This ambiguity complicates the code search process, as the queries do not provide a clear overview of the code’s purpose. Our analysis reveals that while ambiguous queries may not precisely summarize the intent of the code, they often share the same general topics as the corresponding code. In light of this discovery, we propose Code Retrieval with Mixture of Experts Prototype Learning Based on Classification (CRME), a novel approach that combines classification for prototype-based representation learning and result ensembling. CRME utilizes specialized pre-trained models focused on the specific domains of ambiguous queries. It consists of two key components: Multiple Classification Prototype and Representation Learning with a Prototype-based Multi-model Contrastive (PMC) Loss during training, and Multi-Prototype Mixture of Experts Integration (MP-MoE) module for fine-grained ensemble inference. Our method can effectively address the issue of query ambiguity and improves search precision. Experimental results on the CodeSearchNet dataset, covering six sub-datasets, show that CRME outperforms existing methods, achieving an average MRR score of 81.4\%. When applied to pre-trained models like CodeBERT, GraphCodeBERT, UniXcoder and CodeT5+, CRME can effectively boosts their performances.}
}

@inproceedings{10.1145/3755881.3755933,
  author = {Gong, Lina and Wang, Chen and Cui, Di and Huang, Yujun and Wei, Mingqiang},
  title = {UITrans: Seamless UI Translation from Android to HarmonyOS},
  booktitle = {Proceedings of the 16th International Conference on Internetware},
  year = {2025},
  month = {oct},
  pages = {142–146},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3755881.3755933},
  url = {https://doi.org/10.1145/3755881.3755933},
  isbn = {9798400719264},
  keywords = {UI Translation, Android, HarmonyOS, Large Language Models(LLMs)},
  abstract = {Seamless user interface (i.e., UI) translation has emerged as a pivotal technique for modern mobile developers, addressing the challenge of developing separate UI applications for Android and HarmonyOS platforms due to fundamental differences in layout structures and development paradigms. In this paper, we present UITrans, the first automated UI translation tool designed for Android to HarmonyOS. UITrans leverages an LLM-driven multi-agent reflective collaboration framework to convert Android XML layouts into HarmonyOS ArkUI layouts. It not only maps component-level and page-level elements to ArkUI equivalents but also handles project-level challenges, including complex layouts and interaction logic. Our evaluation of six Android applications demonstrates that our UITrans achieves translation success rates of over 90.1\%, 89.3\%, and 89.2\% at the component, page, and project levels, respectively. UITrans is available at https://github.com/OpenSELab/UITrans and the demo video can be viewed at https://www.youtube.com/watch?v=iqKOSmCnJG0.}
}

@inproceedings{10.1145/3711542.3711566,
  author = {Ghosh, Sagarika and Das, Soma and Chatterji, Sanjay and Pratihar, Sanjoy},
  title = {Cross-Language Code Matching with IR2Vec and Cross-Entropy Loss},
  booktitle = {Proceedings of the 2024 8th International Conference on Natural Language Processing and Information Retrieval},
  year = {2025},
  month = {apr},
  pages = {173–178},
  numpages = {6},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3711542.3711566},
  url = {https://doi.org/10.1145/3711542.3711566},
  isbn = {9798400717383},
  keywords = {Cross-Language, Code matching, IR2Vec, Cross entropy, CodeBERT, RoBERTa},
  abstract = {In contemporary software development and maintenance, the practice of reusing or copy-pasting code is prevalent to expedite processes. Consequently, numerous techniques have been developed to detect, compare, or match similar code within the same programming language. However, there remains a need for methods capable of detecting, comparing, or matching similar code across different programming languages. This paper presents a neural model utilizing IR2Vec embeddings and cross-entropy loss to facilitate the matching of similar code between disparate languages, such as C and C++. The proposed model achieves a matching accuracy of  (94.06 \% ) . To evaluate the model’s efficacy, we compute Precision, Recall, and F1 score across various threshold values.}
}

@book{10.1145/3759425,
  title = {Proceedings of the 1st ACM SIGPLAN International Workshop on Language Models and Programming Languages},
  series = {LMPL '25},
  year = {2025},
  month = {sep},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3759425},
  isbn = {9798400721489},
  abstract = {Welcome to the 1st International Workshop on Language Models and Programming Languages (LMPL 2025), held in Singapore, 15 October 2025, co-located with ICFP/SPLASH 2025. LMPL brings together the programming-languages and machine-learning communities to explore how large language models and programming language techniques inform and advance each other across analysis, verification, synthesis, testing, and optimization. As the inaugural edition of the LMPL series, our goal is to establish a shared venue for rigorous, forward-looking work at the LLM–PL interface. We aim to (i) surface the primary challenges of LLM-driven solutions for PL problems and other applications, (ii) provide a forum to exchange new ideas and preliminary results, and (iii) foster collaboration between academia and industry so that programming-language methodologies can meaningfully shape LLM applications.}
}

@inproceedings{10.1145/3746059.3747636,
  author = {Freund, Stephen N. and Simon, Brooke and Berger, Emery D. and Jun, Eunice},
  title = {Flowco: Mixed-Initiative Authoring of Reliable End-to-End Data Analyses via Dataflow Graphs and LLMs},
  booktitle = {Proceedings of the 38th Annual ACM Symposium on User Interface Software and Technology},
  year = {2025},
  month = {sep},
  number = {Article 182},
  pages = {1–20},
  numpages = {20},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3746059.3747636},
  url = {https://doi.org/10.1145/3746059.3747636},
  isbn = {9798400720376},
  keywords = {data analysis, dataflow graphs, LLMs, mixed-initiative systems, interactive systems},
  abstract = {Conducting data analysis typically involves authoring code to transform, visualize, analyze, and interpret data. Large Language Models (LLMs) are now capable of generating such code for simple, routine analyses, and they have the potential to democratize data science by enabling those with limited programming expertise to conduct data analyses, including in scientific research, business, and policymaking. However, analysts in many real-world settings must often exercise fine-grained control over specific analysis steps, verify intermediate results explicitly, and iteratively refine their analytical approaches. Such tasks present barriers to building robust and reproducible analyses using LLMs alone or even in conjunction with existing authoring tools (e.g., computational notebooks). This paper introduces Flowco, a new mixed-initiative system to address these challenges. Flowco leverages a visual dataflow programming model and integrates LLMs into every phase of the authoring process. A preliminary user evaluation suggests that Flowco supports analysts, particularly those with less programming experience, in quickly authoring, debugging, and refining data analyses.}
}

@article{10.1145/3762990,
  author = {Meijer, Erik},
  title = {Guardians of the Agents: Formal verification of AI workflows},
  journal = {Queue},
  year = {2025},
  month = {sep},
  volume = {23},
  number = {4},
  pages = {66–85},
  numpages = {20},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3762990},
  url = {https://doi.org/10.1145/3762990},
  issn = {1542-7730},
  abstract = {To mitigate against models going off the rails during inference, people often use so-called guardrails to dynamically monitor, filter, and control model responses for problematic content. Guardrails, however, come with their own set of problems such as false positives caused by pattern matching against a fixed set of forbidden words. This mathematical proof-based approach addresses these limitations by providing deterministic and verifiable assurances of safety without the need to trust the AI nor any of the artifacts it produces.}
}

@book{10.1145/3733802,
  editor = {Zhou, Jianying and Reijsbergen, Daniël and Chekole, Eyasu Getahun},
  title = {Proceedings of the 24th Workshop on Privacy in the Electronic Society},
  series = {WPES '25},
  year = {2025},
  month = {sep},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3733802},
  isbn = {9798400718984},
  abstract = {It is with great pleasure that I reflect on my role as Program Committee Chair for WPES 2025. The success of this conference is a testament to the collective dedication and tireless efforts of many individuals. First and foremost, I extend my heartfelt gratitude to all the authors whose innovative research and contributions form the foundation of this year's program. I am equally indebted to the Program Committee members and reviewers, whose expertise, rigor, and commitment ensured the high quality of the accepted submissions. Your thoughtful evaluations and constructive feedback have been invaluable. I would like to particularly thank the Publication Chair, Daniël Reijsbergen, for taking care of the proceedings, and the Web Chair, Eyasu Getahun Chekole, for creating and maintaining the conference website. Finally, I wish to express my sincere appreciation to the steering committee for their guidance and support throughout this journey. Their leadership has been crucial in navigating challenges and realizing our goals.It is with great excitement that we see such a large number of high-quality submissions from all over the world. Many submissions present novel contributions related to real-world aspects of digital privacy, demonstrating accessible and compelling results to general computer security researchers. A total of 37 submissions were received, of which 31 were full papers and 6 were short papers. After a rigorous review process, 18 submissions were accepted for publication, of which 15 were full papers (acceptance rate: ≈48.39\%) and 3 were short papers (acceptance rate: 50\%). As such, the total acceptance rate was ≈48.64\%. For the first time, WPES will feature a best paper award: the result will be announced at the closing session of WPES’25.}
}

@inproceedings{10.1145/3689187.3709614,
  author = {Prather, James and Leinonen, Juho and Kiesler, Natalie and Gorson Benario, Jamie and Lau, Sam and MacNeil, Stephen and Norouzi, Narges and Opel, Simone and Pettit, Vee and Porter, Leo and Reeves, Brent N. and Savelka, Jaromir and Smith, David H. and Strickroth, Sven and Zingaro, Daniel},
  title = {Beyond the Hype: A Comprehensive Review of Current Trends in Generative AI Research, Teaching Practices, and Tools},
  booktitle = {2024 Working Group Reports on Innovation and Technology in Computer Science Education},
  year = {2025},
  month = {jan},
  pages = {300–338},
  numpages = {39},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3689187.3709614},
  url = {https://doi.org/10.1145/3689187.3709614},
  isbn = {9798400712081},
  keywords = {artificial intelligence, computing education, genai, generative ai, large language models, pedagogical practices, teaching computing},
  abstract = {Generative AI (GenAI) is advancing rapidly, and the literature in computing education is expanding almost as quickly. Initial responses to GenAI tools were mixed between panic and utopian optimism. Many were fast to point out the opportunities and challenges of GenAI. Researchers reported that these new tools are capable of solving most introductory programming tasks and are causing disruptions throughout the curriculum. These tools can write and explain code, enhance error messages, create resources for instructors, and even provide feedback and help for students like a traditional teaching assistant. In 2024, new research started to emerge on the effects of GenAI usage in the computing classroom. These new data involve the use of GenAI to support classroom instruction at scale and to teach students how to code with GenAI. In support of the former, a new class of tools is emerging that can provide personalized feedback to students on their programming assignments or teach both programming and prompting skills at the same time. With the literature expanding so rapidly, this report aims to summarize and explain what is happening on the ground in computing classrooms. We provide a systematic literature review; a survey of educators and industry professionals; and interviews with educators using GenAI in their courses, educators studying GenAI, and researchers who create GenAI tools to support computing education. The triangulation of these methods and data sources expands the understanding of GenAI usage and perceptions at this critical moment for our community.}
}

