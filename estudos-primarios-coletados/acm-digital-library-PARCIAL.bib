@article{10.1145/3748239.3748247,
  author = {Arga, Ludovic and Bélorgey, François and Braud, Arnaud and Carbou, Romain and Charbonniaud, Nathalie and Colomes, Catherine and Delphin-Poulat, Lionel and Excoffier, David and Fauché, Christel and George, Thomas and Guyard, Frédéric and Hassan, Thomas and Lampin, Quentin and Lemaire, Vincent and Nodet, Pierre and Piotrowski, Pawel and Sapiejewski, Krzysztof and Sirvent-Hien, Emilie and Tosic, Tamara},
