@inproceedings{10.1145/3822455.3838762,
  author = {North, Marc and Bencomo, Nelly and Atapour-Abarghouei, Amir},
  title = {Preserving Model-to-Code Traceability During LLM-Based Code Generation},
  booktitle = {Proceedings of the ACM/IEEE 29th International Conference on Model Driven Engineering Languages and Systems},
  year = {2026},
  month = {oct},
  pages = {358–364},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3822455.3838762},
  url = {https://doi.org/10.1145/3822455.3838762},
  isbn = {9798400728099},
  abstract = {Large language models (LLMs) are increasingly used for model-to-code generation, but they weaken one of the central properties of model-driven engineering: traceability between design models and generated implementation artefacts. Existing approaches either rely on deterministic transformations, where trace links can be produced by construction, or treat traceability as a post-hoc recovery problem, where links are reconstructed after code has already been generated. This paper investigates a different possibility: preserving model-to-code traceability during LLM-based code generation. We study generation from UML class diagrams, represented in XMI, to Java and Python code. During generation, we capture token-level attribution between the model input and generated code output, and aggregate these signals into trace links between model elements and code features. We evaluate input masking, gradient-based attribution, and internal intervention techniques as mechanisms for preserving traceability during generation. Across open-weight LLMs of different sizes, value zeroing performs best, identifying the correct trace link with 90\% top-1 accuracy and more than 95\% top-5 accuracy. The results suggest that generating LLMs contain signals that can support meaningful model-to-code traceability, without requiring trace links to be reconstructed only after generation. This paper therefore reframes LLM-based model-to-code generation as a traceability-preservation problem. This opens a research direction for AI-supported MDE in which trace links are treated as engineering artefacts produced alongside generated code, rather than as evidence recovered afterwards.}
}

@inproceedings{10.1145/3796315.3796363,
  author = {Peng, Jianshan and Huang, Runhe and Chen, Yufan and Hosobe, Hiroshi and Chen, Wenqiang and Li, Shijian},
  title = {Emergency Medicine Finding for Older Adults Living Alone Using 3D Gaussian Splatting and LLMs},
  booktitle = {Proceedings of the 2026 9th International Conference on Software Engineering and Information Management},
  year = {2026},
  month = {may},
  pages = {350–356},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3796315.3796363},
  url = {https://doi.org/10.1145/3796315.3796363},
  isbn = {9798400721731},
  keywords = {3D Gaussian Splatting, Assistive robotics, elderly care, human–robot interaction, large language models, scene understanding, service robots},
  abstract = {Older adults with coronary artery disease face critical risks if they cannot instantly locate emergency medicines (e.g., nitroglycerin) during acute episodes like chest pain. In such high-stress moments, traditional robotic search methods relying on physical exploration are often too slow. This paper presents a novel assistive framework integrating Large Language Models (LLMs) with 3D Gaussian Splatting (3DGS) for rapid medicine localization. Instead of physical navigation, our system employs an LLM to interpret spoken user queries—ranging from specific drug names to vague symptom descriptions—and extracts visual targets. It then executes a "Virtual Search" within a pre-constructed, high-fidelity 3DGS digital twin of the environment. This approach allows the system to instantly verify the medicine's presence and determine its precise coordinates without requiring robot movement. Experimental results demonstrate the framework's efficacy in mapping ambiguous health complaints to specific medicines and successfully detecting small pill containers in cluttered scenes, offering a responsive "visual memory" solution for elderly care.}
}

@article{10.1145/3828168,
  author = {Wang, Yue and Zhao, Yuan and Yu, Shengcheng and Chen, Zhenyu and Gu, Qing},
  title = {More than a Judge: An Empirical Study of Agent–Human Interaction in Crowdsourced Testing Assessment},
  journal = {ACM Trans. Softw. Eng. Methodol.},
  year = {2026},
  month = {nov},
  volume = {35},
  number = {11},
  pages = {1–29},
  numpages = {29},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3828168},
  url = {https://doi.org/10.1145/3828168},
  issn = {1049-331X},
  keywords = {Crowdsourced Testing, Agent–Human Interaction, LLM-as-a-Judge, Large Language Models},
  abstract = {Agentic AI is increasingly being integrated into software engineering workflows, and crowdsourced testing is no exception. In this setting, the large volume and uneven quality of submitted test reports still create a substantial review burden for developers. To help address this burden, we previously developed and validated a multi-agent assessment backbone based on the LLM-as-a-Judge paradigm. The backbone, which assesses reports along the dimensions of textuality, adequacy, and competitiveness, was shown to align well with human consensus while substantially reducing assessment effort. Yet reliable automated judging does not by itself show whether agent outputs can improve human work when embedded into the workflow. This article studies that missing question in the context of crowdsourced testing. We investigate whether assessment-derived, actionable feedback can improve how testers revise reports, perform on later tasks, and transfer reporting practices across applications. To do so, we conducted a controlled four-stage human-subject study with 20 testers across three real-world applications. The results show that agent-generated feedback supports immediate improvements in revised reports, better first submissions on a new task after prior feedback exposure, and evidence of partial but meaningful transfer to a later application. A post-task questionnaire completed by 17 participants complements these artifact-based findings by suggesting that the feedback was generally understandable, acted upon in revision, and carried into later tasks, while also revealing remaining friction in specificity and execution. Overall, the study provides empirical evidence that, in the studied crowdsourced testing setting, assessment agents can serve not only as post-hoc judges but also as workflow-integrated feedback providers that support upstream report-quality improvement.}
}

@inproceedings{10.1145/3793653.3793795,
  author = {Görnitz, Nico and Occsner, Lucca and Hoffmann, Geerd-Dietger},
  title = {MLOX: Open-Source MLOps for the Rest of Us},
  booktitle = {Proceedings of the IEEE/ACM 5th International Conference on AI Engineering - Software Engineering for AI},
  year = {2026},
  month = {sep},
  pages = {293–298},
  numpages = {6},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3793653.3793795},
  url = {https://doi.org/10.1145/3793653.3793795},
  isbn = {9798400724756},
  abstract = {Machine Learning Operations (MLOps)\&nbsp;[1] remains a major challenge even for large organizations—and even more so for individuals and small teams that lack the budget, expertise, or infrastructure to run enterprise-grade systems. Managed cloud suites, while powerful, are expensive, complex, and tied to proprietary ecosystems. MLOX[3] (MLOps-in-a-Box) addresses this gap with an easy-to-use, secure, and fully open-source framework that transforms ordinary virtual or on-premise servers into cohesive, observable, and sustainable MLOps environments. Instead of relying on complex infrastructure-as-code, MLOX provides a service-centric, backend-agnostic architecture that supports Docker, Kubernetes, native, and hybrid connectors out of the box. It integrates the full AI workflow—including model tracking, orchestration, serving, monitoring, registry management, and secret handling—on low-cost hardware while emphasizing transparency, energy efficiency, and reproducibility. Developed within Germany’s Prototype Fund program, MLOX focuses on pragmatic engineering and accessibility: it enables professional-grade MLOps for individuals and small teams without vendor lock-in or heavy operational overhead. The long-term vision is to deliver an affordable, sustainable, and best-practice-aligned alternative to commercial MLOps platforms.}
}

@inproceedings{10.1145/3796624.3796667,
  author = {Indongo, Naftali Ndeapo and Smith, Rachel Charlotte and Winschiers-Theophilus, Heike and Kandjengo, Shorty and Mbinge, Uariaike},
  title = {Designing Responsible AI with Indigenous Communities: Towards Participatory AI with ovaHimba and San People in Namibia},
  booktitle = {Proceedings of the 19th Participatory Design Conference 2026, Vol. 1: Full Papers},
  year = {2026},
  month = {jun},
  pages = {446–456},
  numpages = {11},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3796624.3796667},
  url = {https://doi.org/10.1145/3796624.3796667},
  isbn = {9798400721052},
  keywords = {Participatory Artificial Intelligence, Responsible AI, Participatory Design, Hydroponics System, Indigenous Communities, Indigenous Knowledge, Resilience},
  abstract = {This paper investigates the co-design of responsible Artificial Intelligence systems within three interconnected AI-driven projects with Namibian Indigenous communities. Three small-scale projects; Smart Hydroponics, Himbaverse, and Resilience App were explored and prototyped through a co-design process. The research aims to promote responsible AI development that enhances trust and aligns with local community aspirations, needs and goals of sustainability and integration of Indigenous Knowledge Systems (IKS) with advanced technology to empower local cultures. The research approach is based on participatory design and technology prototyping with ovaHimba and San communities in Namibia. It shows that transparency and active participation empower communities to contribute to the development of evolving knowledge bases and RAI system capabilities. Preliminary findings reveal that responsible AI design must be deeply contextual and shaped by local cultural values, knowledge systems, and community-defined objectives. The study contributes to the growing discourse on participatory AI development, demonstrating how culturally responsive AI systems can empower Indigenous communities and promote equitable technological integration.}
}

@book{10.1145/3843777,
