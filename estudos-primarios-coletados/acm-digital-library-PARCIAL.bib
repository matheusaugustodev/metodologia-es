@inproceedings{10.1145/3770855.3819049,
  author = {Qiu, Zhisong and Qiao, Shuofei and Xu, Kewei and Zhu, Yuqi and Du, Lun and Zhang, Ningyu and Chen, Huajun},
  title = {Rewarding the Scientific Process: Process-Level Reward Modeling for Agentic Data Analysis},
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
  year = {2026},
  month = {aug},
  pages = {11866–11877},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3770855.3819049},
  url = {https://doi.org/10.1145/3770855.3819049},
  isbn = {9798400722592},
  keywords = {process reward models, data analysis agent, large language models},
  abstract = {Process Reward Models (PRMs) have achieved remarkable success in augmenting the reasoning capabilities of Large Language Models (LLMs) within static domains such as mathematics. However, their potential in dynamic data analysis tasks remains underexplored. In this work, we first present an empirical study revealing that general-domain PRMs struggle to supervise data analysis agents. Specifically, they fail to detect silent errors, logical flaws that yield incorrect results without triggering interpreter exceptions, and erroneously penalize exploratory actions, mistaking necessary trial-and-error exploration for grounding failures. To bridge this gap, we introduce DataPRM, a novel environment-aware generative process reward model that (1) can serve as an active verifier, autonomously interacting with the environment to probe intermediate execution states and uncover silent errors, and (2) employs a reflection-aware ternary reward strategy that distinguishes between correctable grounding errors and irrecoverable mistakes. We design a scalable pipeline to construct over 7K high-quality training instances for DataPRM via diversity-driven trajectory generation and knowledge-augmented step-level annotation. Experimental results demonstrate that DataPRM improves downstream policy LLMs by 7.21\% on ScienceAgentBench and 11.28\% on DABStep using Best-of-N inference. Notably, with only 4B parameters, DataPRM outperforms strong baselines, and exhibits robust generalizability across diverse Test-Time Scaling strategies. Furthermore, integrating DataPRM into Reinforcement Learning yields substantial gains over outcome-reward baselines, achieving 78.73\% on DABench and 64.84\% on TableBench, validating the effectiveness of process reward supervision.}
}

@article{10.1145/3798265,
  author = {Yuan, Hengchen and Lin, Jiefang and Shi, August},
  title = {Detecting Flaky Tests by Controlling Nondeterministic API Behavior},
  journal = {Proc. ACM Program. Lang.},
  year = {2026},
  month = {apr},
  volume = {10},
  number = {OOPSLA1},
  pages = {1790–1816},
  numpages = {27},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3798265},
  url = {https://doi.org/10.1145/3798265},
  keywords = {flaky tests, nondeterminism, API perturbation},
  abstract = {Regression testing is an essential part of software development to ensure high-quality software; but the presence of flaky tests makes the testing outcomes unreliable. It is essential to proactively detect flaky tests, so developers are aware of them early on and can react appropriately in case they fail. While there has been prior work in detecting flaky tests, they either are developed to focus on specific flaky test types or can be imprecise in their analyses, such as by relying on AI models for prediction.We present ChaosAPI, a framework to support detecting a variety of different types of flaky tests. Our insight is that the most effective approach to detecting flaky tests is to target the nondeterministic components that lead tests to have the flaky behavior in the first place. In particular, we target specific APIs within the Java Standard Library that all Java code relies on and that are known to exhibit nondeterministic behavior, such as those related to system time, concurrency, and environmental factors. During test execution, ChaosAPI modifies the behavior of these API calls, perturbing inputs and return values of these APIs in a systematic manner while still remaining compliant with the API specification. We can detect flaky tests by observing whether tests that previously passed would now fail when run through ChaosAPI.Our evaluation on a prior dataset of known flaky tests, as well as running on test suites of other popular open-source projects, demonstrates that ChaosAPI not only detects more flaky tests than simple rerunning across a wide range of projects but also detects them more efficiently, making ChaosAPI a practical addition to the toolbox of flaky test detection techniques.}
}

@inproceedings{10.1145/3812836.3814760,
  author = {Radu, Valentin and Foley, Myles and Vahdat Pour, Maryam and Pegoraro, Massimo and Faricy, Frank and Girolami, Mark},
  title = {CrossBench: Reproducible LLM Memory Evaluation Across Conversational and Coding Workloads},
  booktitle = {Proceedings of the 24th Annual International Conference on Mobile Systems, Applications and Services Workshops},
  year = {2026},
  month = {jun},
  pages = {87–92},
  numpages = {6},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3812836.3814760},
  url = {https://doi.org/10.1145/3812836.3814760},
  isbn = {9798400727122},
  keywords = {large language models, memory systems, benchmarking, reproducibility, open-source evaluation},
  abstract = {External memory systems—LLM-attached stores that persist, compress, and retrieve information across long horizons—are becoming a load-bearing layer for conversational, coding, and agentic LLM applications. Yet evaluating them is broken in two compounding ways. Reproducibility: high-profile systems publish headline numbers from managed cloud platforms whose extraction, consolidation, and re-ranking logic ships behind a paywall, leaving open-source SDKs unable to match the advertised scores—a gap several projects acknowledge themselves. Fragmentation: every benchmark claiming to measure "LoCoMo accuracy" quietly redefines the metric, question set, or prompt format, making cross-system comparisons unsound by construction. We present CrossBench, an open-source platform that puts memory-system evaluation on shared, fair footing. It provides the first in-process, faithful re-implementation of seven prominent architectures alongside a unified adapter framework spanning eleven benchmarks (three conversational, eight coding), with an open interface for contributing more. Beyond accuracy, CrossBench surfaces the metrics that matter for comparing LLM backbones, memory systems, and prompt strategies—per-stage latency and token economy—especially relevant under constrained compute. Three execution modes (single-shot, agentic, conversational) compose via stackable profiles that decouple LLM, memory, and benchmark choices.}
}

@inproceedings{10.1145/3776574.3831136,
  author = {Ma, Zhengyang},
  title = {Han-Vibe: Culturally-Situated Multimodal Interaction for AI-Mediated Live Music Performance},
  booktitle = {Proceedings of the 28th International Conference On Multimodal Interaction},
  year = {2026},
  month = {oct},
  pages = {258–262},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3776574.3831136},
  url = {https://doi.org/10.1145/3776574.3831136},
  isbn = {9798400723186},
  keywords = {multimodal interaction, audio and music, arts and creativity, speech processing, user experience design, touch and gesture},
  abstract = {We present Han-Vibe, a terminal-based multimodal system for live electronic music performance that unifies direct manipulation, live DSP editing, AI-mediated natural-language control, offline voice triggers, and community resource sharing in a culturally situated workflow we term vibe performing. The design draws on hanmai (喊麦), a Chinese internet music tradition in which an MC’s voice modulates a live-streamed performance. Han-Vibe organizes three input modalities (tactile, linguistic, vocal) into four interaction paradigms: TuneTouch (keyboard parameter control), LiveForge (hot-reloadable Faust DSP editing), VibeLink-Text (LLM-mediated typed intent), and VibeLink-Voice (offline keyword-to-scene mapping). The PulseHub (脉冲社) resource layer supplies reusable DSP and scenes through VibeLink-Text. We report component-level latency measurements as a necessary technical characterization, not an evaluation of usability or creative value. Completed asynchronous commands are scheduled at the first subsequent bar boundary, preserving grid alignment while leaving the performer’s waiting time variable. We discuss the contribution and limits of this culturally situated design case.}
}

@inproceedings{10.1145/3793928.3801117,
  author = {Bala Mahalingam, Vijay and Parthasarathy, Harish and Baskaran, Aakash and Chandrasekaran, Bharath and Rajeshkumar, Muthukrishnan},
  title = {Evaluating the Complex Reasoning and Performance Capabilities of Large Language Models for Test Case Generation: A Learning-Based Software Testing Suite for Benchmarking Generative AI in Automated Test Case Generation},
  booktitle = {Proceedings of the 2026 10th International Conference on Control Engineering and Artificial Intelligence},
  year = {2026},
  month = {may},
  pages = {60–67},
  numpages = {8},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3793928.3801117},
  url = {https://doi.org/10.1145/3793928.3801117},
  isbn = {9798400721779},
  keywords = {Generative AI, Large Language Models (LLMs), Model evaluation, Automated test generation, AI-driven software testing, Test case generation, Reasoning complexity, Complexity score, Operation coverage, Edge case handling},
  abstract = {Modern large language models (LLMs) have demonstrated the ability to generate software test cases, but their reasoning complexity and performance vary widely. This paper presents a systematic evaluation of ten state-of-the-art generative AI models on the task of automated test case generation. We introduce a unified benchmarking framework that measures both the quality of the generated tests – via a complexity score and coverage of key testing operations – and the performance – via response time and output quantity. Our experiments reveal significant differences: some models produce highly complex, thorough test suites (with extensive assertions and even error-handling cases) but at slower speeds, while others respond faster yet with simpler, less rigorous tests. These findings underscore the importance of specialized evaluation methods for AI-driven software testing and demonstrate how our Learning-Based Software Testing (LBST) suite can benchmark LLMs’ complex reasoning capabilities in generating test cases.}
}

@inproceedings{10.1145/3770855.3817474,
  author = {Hu, Silan and Zhang, Shiqi and Shi, Yimin and Xiao, Xiaokui},
  title = {GEM-Bench: A Benchmark for Ad-Injected Response Generation within Generative Engine Marketing},
  booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
  year = {2026},
  month = {aug},
  pages = {9103–9112},
  numpages = {10},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3770855.3817474},
  url = {https://doi.org/10.1145/3770855.3817474},
  isbn = {9798400722592},
  keywords = {generative ai monetization, ad-injected response generation},
  abstract = {Generative Engine Marketing (GEM) is an emerging ecosystem for monetizing generative engines, such as LLM-based chatbots, by seamlessly integrating relevant advertisements into their responses. At the core of GEM lies the generation and evaluation of ad-injected responses. However, existing benchmarks are not specifically designed for this purpose, which limits future research. To address this gap, we propose GEM-Bench, the first comprehensive benchmark for ad-injected response generation in GEM. GEM-Bench includes three curated datasets covering both chatbot and search scenarios, a metric ontology that captures multiple dimensions of user satisfaction and engagement, and several baseline solutions implemented within an extensible multi-agent framework. Our preliminary results indicate that, while simple prompt-based methods achieve reasonable engagement such as click-through rate, they often reduce user satisfaction. In contrast, approaches that insert ads based on pre-generated ad-free responses help mitigate this issue but introduce additional overhead. These findings highlight the need for future research on designing more effective and efficient solutions for generating ad-injected responses in GEM.}
}

@inproceedings{10.1145/3774905.3795606,
  author = {Hasan, A B M Mehedi and Brankovic, Ljiljana and Sanin, Cesar and Paul, David},
  title = {Bridging the Semantic Gap: A Homonym-Aware Ontology Platform for Cybersecurity Interoperability},
  booktitle = {Companion Proceedings of the ACM Web Conference 2026},
  year = {2026},
  month = {may},
  pages = {242–250},
  numpages = {9},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3774905.3795606},
  url = {https://doi.org/10.1145/3774905.3795606},
  isbn = {9798400723087},
  keywords = {cybersecurity ontology, semantic gap, homonym-awareness, knowledge graphs, interoperability, dynamic seeding},
  abstract = {The cybersecurity domain exhibits a substantial semantic gap between the operational reality of threat detection and the available static compliance standards (e.g., ISO 27001, NIST SP 800-53). In addition, a disconnect is evident between high-level business goals to protect assets (e.g., Security Services such as Confidentiality) and low-level technical root causes (e.g., Vulnerabilities such as Buffer Overflow). Our previous Systematic Literature Review (SLR) has identified numerous existing ontologies. A persistent structural deficiency is identified: the lack of a dynamic, interoperable platform that supports safe, continuous mapping among Security Services, Security Mechanisms, Attacks, Exploited Vulnerabilities, Attackers, and Assets, with continuous community evaluation. Existing solutions limit practitioners to static, read-only standards for achieving security services, resulting in a lack of agility and a semantic void between the how and the why. This paper proposes a wiki-style, agile, and homonym-aware editing prototype system, which can lead to a novel hybrid cybersecurity ontology with a management and visualisation platform to bridge this semantic gap. We implement the Golden Chain of knowledge identified in prior SLRs (Security Services ? Security Mechanisms ? Attacks ? Vulnerabilities ? Attackers ? Assets) through three core technical contributions: (a) A Concept-Term Separated Architecture that the potential to resolve synonymy and homonymy; (b) An Additive Seeder Engine that enables systematic, preserving distributed updates; and (c) A Hybrid Contribution Model we bridge CSV ? JSON batch processing with granular Web-based expert review. We evaluate this prototype by unifying a number of concepts from different sources (NIST, MITRE, ISO, CyBOK) into a single, cohesive, graph-ready knowledge base. Our results demonstrate that this ''living'' ontology approach can successfully interpret homonyms (e.g., ''Virus'' as malware vs. pathogen) and facilitate cross-domain knowledge retrieval.}
}

@article{10.1145/3806391,
  author = {Simon, Emmanuel and Hettiarachchi, Chirath and Fard, Fatemeh and Potanin, Alex and Suominen, Hanna},
  title = {A Survey of Algorithm Debt in Machine and Deep Learning Systems: Definition, Smells, and Future Work},
  journal = {ACM Comput. Surv.},
  year = {2026},
  month = {apr},
  volume = {58},
  number = {11},
  pages = {1–35},
  numpages = {35},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3806391},
  url = {https://doi.org/10.1145/3806391},
  issn = {0360-0300},
  keywords = {Technical debt, algorithm debt, machine learning, deep learning, software quality, systematic literature review},
  abstract = {The adoption of Machine and Deep Learning (ML/DL) technologies introduces maintenance challenges, leading to Technical Debt (TD). Algorithm\&nbsp;Debt (AD) is a TD type that impacts the performance and scalability of ML/DL systems. A review of 42 primary studies expanded AD’s definition, uncovered its implicit presence, identified its smells, and highlighted future directions. These findings will guide an AD-focused study, enhancing the reliability of ML/DL systems.}
}

@inproceedings{10.1145/3777884.3796995,
  author = {Anggraito, Adityo and Razumchik, Rostislav and Marin, Andrea},
  title = {Kill Smart, Run Fast: Using Job Termination for Resource Efficiency in Data Centers},
  booktitle = {Proceedings of the 17th ACM/SPEC International Conference on Performance Engineering},
  year = {2026},
  month = {may},
  pages = {37–51},
  numpages = {15},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3777884.3796995},
  url = {https://doi.org/10.1145/3777884.3796995},
  isbn = {9798400723254},
  keywords = {datacenter job scheduling, preemption-restart, multiserver-job queueing systems},
  abstract = {For the last few years, job scheduling in large data centers has been attracting many research interests, especially because of the larger scales of these infrastructures and the drastic change in the workload characteristics introduced by AI jobs. The high variability in the resource demands (in terms of memory, number of cores, GPUs, etc.) makes the scheduling design extremely complicated, and the maximum achievable throughput is limited with respect to the amount of available resources. This is due to the head-of-line blocking (HOL), i.e., the scheduler has to wait for the termination of some jobs to make space for a job demanding many resources. In this paper, we study a killing policy that serves the jobs in a nearly First-Come First-Served (FCFS) order, i.e., the scheduler preempts the jobs in service to make space for a large job. In order to make the analysis realistic, we assume that the preempted jobs must be restarted once they enter again in service. Our results are summarized as follows: (i) we show that we can achieve higher throughput than standard FCFS beside the waste of computational resources due to the restart policy, (ii) we study a queueing model that allows us to understand the trade-off among throughput, fairness and energy waste in a simplified scenario, (iii) we use discrete event simulation to show that the killing policy allows for higher throughput and lower expected response times of jobs with workload characteristics derived from the traces, released by Google, of the Borg scheduler with respect to FCFS.}
}

@inproceedings{10.1145/3786335.3813217,
  author = {Jariwala, Sarthak},
  title = {SQLsaber: Agentic SQL Assistant for Efficient and High-Accuracy Natural Language Database Exploration},
  booktitle = {Proceedings of the ACM Conference on AI and Agentic Systems},
  year = {2026},
  month = {may},
  pages = {1213–1217},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3786335.3813217},
  url = {https://doi.org/10.1145/3786335.3813217},
  isbn = {9798400724152},
  keywords = {Natural language interfaces to databases, Text-to-SQL, Large language models, Agentic systems},
  abstract = {Natural language interfaces to databases have long been a goal of human-computer interaction research, yet current Text-to-SQL approaches still struggle with complex query execution accuracy (EX). We introduce SQLsaber, a safe and extensible open-source agentic SQL assistant designed for high accuracy natural language database exploration. SQLsaber is available as both an interactive CLI and Python SDK, and is only equipped with four core tools — list-tables, introspect-schema, search-knowledge, and execute-sql — which together enable it to progressively discover schema context, retrieve domain knowledge, generate queries, and self-correct using execution feedback. Here, we demonstrate the power of tool use and agentic approach for high accuracy natural language database exploration. Furthermore, SQLsaber is designed with defense-in-depth security, including AST-based SQL guards, dialect-specific function denylists, and database-level read-only enforcement, as well as a plugin architecture for extensibility. We evaluate SQLsaber’s performance on challenging questions of the BIRD dev set using three frontier LLMs. All three models surpass 88\% EX, with Claude Opus 4.6 achieving 95.2\% EX, a relative improvement of 47.8\% over the prior best. We further show that the SQLsaber agent is efficient, with Claude Opus 4.6 reaching an answer in median time of 16 seconds with 6 tool calls (median). Finally, through cross-model agreement analysis using SQLsaber, we identify 19 instances of incorrect gold SQL in the benchmark’s challenging set, highlighting the value of agentic exploration for both natural language query answering and benchmark auditing.}
}

@inproceedings{10.1145/3772318.3791275,
  author = {Ye, Runlong and Huang, Oliver and Yung Kang Lee, Patrick and Liut, Michael and Nobre, Carolina and Kong, Ha-Kyung},
  title = {Reflexis: Supporting Reflexivity and Rigor in Collaborative Qualitative Analysis though Design for Deliberation},
  booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
  year = {2026},
  month = {apr},
  number = {Article 1233},
  pages = {1–31},
  numpages = {31},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3772318.3791275},
  url = {https://doi.org/10.1145/3772318.3791275},
  isbn = {9798400722783},
  keywords = {Reflexive Thematic Analysis (RTA); Qualitative Data Analysis; Reflexivity; Positionality; Collaborative Analysis; Analytical Provenance; Design for Deliberation; Sensemaking; Human-AI Collaboration; Large Language Models},
  abstract = {Reflexive Thematic Analysis (RTA) is a critical method for generating deep interpretive insights. Yet its core tenets, including researcher reflexivity, tangible analytical evolution, and productive disagreement, are often poorly supported by software tools that prioritize speed and consensus over interpretive depth. To address this gap, we introduce Reflexis, a collaborative workspace that centers these practices. It supports reflexivity by integrating in-situ reflection prompts, makes code evolution transparent and tangible, and scaffolds collaborative interpretation by turning differences into productive, positionality-aware dialogue. Results from our paired-analyst study (N = 12) indicate that Reflexis encouraged participants toward more granular reflection and reframed disagreements as productive conversations. The evaluation also surfaced key design tensions, including a desire for higher-level, networked memos and more user control over the timing of proactive alerts. Reflexis contributes a design framework for tools that prioritize rigor and transparency to support deep, collaborative interpretation in an age of automation.}
}

