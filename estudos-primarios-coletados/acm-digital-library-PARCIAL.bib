  doi = {10.1145/3744256},
  isbn = {9798400720123},
  abstract = {Welcome to the Thirteenth (13th) ACM International Conference on Systems for Energy Efficient Buildings, Cities, and Transportation (BuildSys'26), in Banff, Canada! Over the past years, BuildSys has facilitated important discussions and developments in the convergence of computer science and disciplines related to the built environment, including engineering, architecture, urban planning, and social science. This year's conference marks the first time we have joined forces with ACM e-Energy to organize two co-located conferences as part of the inaugural ACM Sustainability Week 2026. BuildSys and e-Energy represent separate but complementary research communities that can mutually benefit from closer interaction. ACM BuildSys generally emphasizes optimizations at the edge of the energy system—the buildings, cities, and transportation systems that consume energy—and thus has strong inter-sections with both civil and mechanical engineering. ACM e-Energy generally emphasizes optimizing the energy network, including power generation, transmission, and distribution systems, and thus has historically had strong intersections with the power systems community and electrical engineering. In essence, BuildSys and e-Energy both apply computational techniques to optimize energy use and reduce carbon emissions, but often from different perspectives and using different approaches.}
}

@inproceedings{10.1145/3805621.3807661,
  author = {Abuzakuk, Sami and Kermarrec, Anne-Marie and Palak and Pires, Rafael and Sharma, Rishi and de Vos, Martijn},
  title = {Orbit: Efficient Agentic Inference using Priority Scheduling},
  booktitle = {Proceedings of the Sixth European Workshop on Machine Learning and Systems},
  year = {2026},
  month = {apr},
  pages = {386–396},
  numpages = {11},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3805621.3807661},
  url = {https://doi.org/10.1145/3805621.3807661},
  isbn = {9798400726057},
  keywords = {Large Language Models, Agentic Systems, Serving Systems, Scheduling},
  abstract = {Large language models (LLMs) are increasingly deployed as autonomous agents that execute complex tasks through long sequences of reasoning steps and tool calls. Serving these agentic workloads at scale is a growing priority, yet existing LLM inference engines are mostly designed for single-pass, chat-style interactions. Agentic tasks, however, can fail, and under system congestion, policies such as first come first serve (FCFS) allocate GPU resources equally to all tasks regardless of their likelihood of success, letting failing tasks inflate queue waiting times for tasks that will complete correctly. We introduce Orbit, a trajectory-aware scheduler that addresses this by dynamically deprioritizing tasks predicted to fail, shifting resources toward likely-correct tasks. We present two scheduling algorithms. Orbit-step is a lightweight heuristic that assigns priority inversely proportional to the number of steps a task has taken, leveraging the empirical observation that longer-running tasks are more likely to fail. Orbit-judge uses an asynchronous LLM-as-a-judge that reads partial execution trajectories and predicts task correctness online, enabling finer-grained prioritization. We evaluate both variants on the GAIA benchmark using the Magentic-One benchmark and the GPT-OSS-120B model. Compared to vLLM's default FCFS policy, Orbit-step and Orbit-judge show 11.2\% and 4.3\% decrease in average end-to-end latency, respectively, for correct tasks. These results demonstrate that real-time trajectory observation is a practical and effective signal for resource allocation in agentic serving systems.}
}

@inproceedings{10.1145/3746467.3801509,
  author = {Vasudevan, Poonkuzhali and Reddivari, Sandeep and Ahuja, Sanjay and Niu, Nan},
  title = {Requirements Classification Using Fine-Tuned Transformer Models: A Comparative Study of BERT, RoBERTa, and GPT-4o},
  booktitle = {Proceedings of the 2026 ACM Southeast Conference},
  year = {2026},
  month = {may},
  pages = {199–204},
  numpages = {6},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3746467.3801509},
  url = {https://doi.org/10.1145/3746467.3801509},
  isbn = {9798400720628},
  keywords = {large language models, machine learning, ChatGPT, BERT, RoBERTa, GPT-4o, requirements, classification},
  abstract = {Classifying software requirements as functional requirements (FRs) and non-functional requirements (NFRs) is an important step in the software requirements engineering (RE) process. Recent developments in Natural Language Processing (NLP) have enabled the use of pre-trained transformer-based language models for this classification task. In this study, we fine-tune three pre-trained models, BERT, RoBERTa, and GPT-4o on two different requirements datasets. The fine-tuned models are evaluated using a synthetic medical requirements dataset generated using ChatGPT. Our results show that GPT-4o outperforms both BERT and RoBERTa in terms of F1-score, achieving up to 96\% accuracy for both FR and NFR classification tasks. These findings highlight the potential of transformer-based models for effective requirements classification across various domains and datasets.}
}

@inproceedings{10.1145/3777912.3809155,
  author = {Chen, Zhiyi and Bischof, Zachary and Testart, Cecilia and Dainotti, Alberto},
  title = {AS2Biz: Leveraging Web Presence and AI to Improve AS Business Classification},
  booktitle = {Proceedings of the 2026 ACM Internet Measurement Conference},
  year = {2026},
  month = {oct},
  pages = {59–74},
  numpages = {16},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3777912.3809155},
  url = {https://doi.org/10.1145/3777912.3809155},
  isbn = {9798400723278},
  abstract = {Classifying Autonomous Systems (ASes) by the business sectors of their operating organizations, also referred to as AS business classification, is a relatively recent but increasingly important area of study. However, the only publicly available dataset for this purpose suffers from significant inaccuracies and limited maintainability due to its heavy reliance on third-party sources. We argue that an organization's web presence—particularly its official website—serves as a more reliable and transparent source for business classification, offering broad coverage and regularly updated information. We introduce AS2Biz, a web presence-based methodology for AS business classification. AS2Biz first constructs an AS-to-website mapping dataset, achieving 98.5\% coverage and 94.4\% accuracy, and then mainly leverages large language models to classify textual website content into business categories. The entire methodology is highly automated and cost-efficient. Our final AS2Biz dataset covers 94.3\% of ASes and, on a 220-AS ground truth benchmark, achieves substantially higher accuracy—more than doubling the F1 score on subdivided business categories (0.78 vs 0.37) and improving the F1 score on general business sectors (0.87 vs 0.62).}
}

