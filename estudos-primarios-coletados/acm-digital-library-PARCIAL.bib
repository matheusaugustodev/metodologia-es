@inproceedings{10.5555/3716662.3716715,
  author = {Iqbal, Umar and Kohno, Tadayoshi and Roesner, Franziska},
  title = {LLM Platform Security: Applying a Systematic Evaluation Framework to OpenAI's ChatGPT Plugins},
  booktitle = {Proceedings of the 2024 AAAI/ACM Conference on AI, Ethics, and Society},
  year = {2025},
  month = {feb},
  pages = {611–623},
  numpages = {13},
  publisher = {AAAI Press},
  doi = {10.5555/3716662.3716715},
  abstract = {Large language model (LLM) platforms, such as ChatGPT, have recently begun offering an app ecosystem to interface with third-party services on the internet. While these apps extend the capabilities of LLM platforms, they are developed by arbitrary third parties and thus cannot be implicitly trusted. Apps also interface with LLM platforms and users using natural language, which can have imprecise interpretations. In this paper, we propose a framework that lays a foundation for LLM platform designers to analyze and improve the security, privacy, and safety of current and future third-party integrated LLM platforms. Our framework is a formulation of an attack taxonomy that is developed by iteratively exploring how LLM platform stakeholders could leverage their capabilities and responsibilities to mount attacks against each other. As part of our iterative process, we apply our framework in the context of OpenAI's plugin (apps) ecosystem. We uncover plugins that concretely demonstrate the potential for the types of issues that we outline in our attack taxonomy. We conclude by discussing novel challenges and by providing recommendations to improve the security, privacy, and safety of present and future LLM-based computing platforms. The full version of this paper is available online at: https://arxiv.org/abs/2309.10254}
}

@inproceedings{10.1145/3713081.3732930,
  author = {Tang, Xiaoxuan and Chen, Xinfang and Chen, Dajun and Zhou, Sheng and Jiang, Wei and Li, Yong},
  title = {TestFlow: Advancing Mobile UI Testing through Multi-Step Reinforcement Learning},
  booktitle = {Proceedings of the 34th ACM SIGSOFT International Symposium on Software Testing and Analysis},
  year = {2025},
  month = {jun},
  pages = {190–194},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3713081.3732930},
  url = {https://doi.org/10.1145/3713081.3732930},
  isbn = {9798400714740},
  keywords = {test automation, vision-language Models, LLM-based Agent},
  abstract = {GUI Agents have demonstrated promising applications in mobile UI testing. However, for complex testing tasks, UI agents tend to fail due to their greedy approach in executing step-by-step operations, leading to error accumulation and neglecting long-horizon dependencies. To address these limitations, we propose TestFlow, a novel multi-modal UI testing model that combines Supervised Fine-Tuning with a Task-aware Reinforcement Learning framework. Our approach implements a two-phase training pipeline designed to optimize long-horizon instruction compliance and complex task completion. Additionally, we develop a tailor-made reward function that integrates both process and outcome rewards to improve the completion rate of multi-step tasks. The experimental results demonstrate that TestFlow significantly outperforms the baseline methods, achieving 33. 69\% WTSR and 55. 37\% SSR in cross-page test scenarios. These improvements highlight the practical value of TestFlow in addressing the challenges of modern mobile app testing, particularly in industrial settings requiring high adaptability and reliability.}
}

