  address = {New York, NY, USA},
  doi = {10.1145/3805696.3846039},
  url = {https://doi.org/10.1145/3805696.3846039},
  isbn = {9798400725975},
  keywords = {URL extraction, scholarly documents, multimodal large language models, citation context, open access datasets and software, reproducibility, digital libraries},
  abstract = {Uniform resource locators (URLs) have become ubiquitous in scholarly papers, and extracting them is an upstream task for downstream analyses such as link rot analyses, meta-analyses, and reproducibility studies. Most existing works extract URLs with a monolithic method, such as a regular expression, which assumes URLs appear in a perfect form throughout the text. In practice, layout variety and conversion errors leave many URLs imperfect, without a scheme, or truncated across lines and columns. Although context around a URL is needed to understand its role in a paper, a URL in a footnote or reference sits apart from its citing sentence. We present VisURLX, a pipeline built on a multimodal large language model (MLLM) that reads each rendered page image directly. It preserves page layout such as superscript markers and column structure, and extracts each URL with its target sentence and surrounding context across the body, footnotes, and references. We evaluate VisURLX on sURL-3K, our benchmark of 3,376 manually annotated target sentences with their URLs, using a proprietary backend (GPT-5-mini) and an open-weight backend (Qwen3-VL-32B). VisURLX on GPT-5-mini achieves an end-to-end F1 score of 86.86\%, about 20 points above the strongest heuristic pipeline built on GROBID, PyMuPDF-Layout, and olmOCR. As one application, we classify the extracted URLs into open access datasets and software (OADS), reaching a weighted F1 score of 83.1\%. The code, data, and the full text of every prompt are available at .}
}

@article{10.1145/3805698,
  author = {Wuttke, Joachim and Kleinsorge, Alexander},
  title = {Algorithm 1062: Code Generation for Piecewise Chebyshev Approximation},
  journal = {ACM Trans. Math. Softw.},
  year = {2026},
  month = {jun},
  volume = {52},
  number = {2},
  pages = {1–16},
  numpages = {16},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3805698},
  url = {https://doi.org/10.1145/3805698},
  issn = {0098-3500},
  keywords = {Small-range approximation, Chebyshev approximation, code generation, special function evaluation},
  abstract = {A Lipschitz continuous function  ( f  ) that has a high-precision, albeit slow reference implementation can be evaluated more rapidly by piecewise polynomials, obtained by Chebyshev approximation. The partition into subdomains should be made such that the computation of subdomain index and reduced function argument is fast and introduces no rounding errors. A rigorous analysis of truncation and rounding errors shows that the maximum relative error can be chosen arbitrarily close to  (2 epsilon ) , except around zeroes of  ( f  ) . Alignment of coefficients minimizes cache loading times. Code generation and target algorithms are implemented in the open source project ppapp, maintained at , with a snapshot archived in the Collected Algorithms of the ACM. It has been successfully applied to three real-valued functions in the open source complex error function library libcerf.}
}

@inproceedings{10.1145/3772318.3791176,
  author = {Fan, Guangrui and Liu, Dandan and Pan, Lihu and Zhang, Rui},
  title = {When Help Hurts: Verification Load and Fatigue with AI Coding Assistants},
  booktitle = {Proceedings of the 2026 CHI Conference on Human Factors in Computing Systems},
  year = {2026},
  month = {apr},
  number = {Article 733},
  pages = {1–25},
  numpages = {25},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3772318.3791176},
  url = {https://doi.org/10.1145/3772318.3791176},
  isbn = {9798400722783},
  keywords = {AI‑assisted programming; verification load; cognitive load; developer fatigue; trust calibration; human–AI interaction},
  abstract = {AI coding assistants help, but developers still spend effort verifying model output. We isolate interface effects by holding a single LLM fixed while N = 60 participants solve three Python tasks with Inline, Chat, or Structured prompting, plus a no‑AI control. AI reduced workload by − 18.2 TLX points and time by 22\% (25.0 vs. 32.1\&nbsp;min) and improved correctness (OR = 1.71). Within AI, Inline is fastest and lowest‑load on simple work; Chat yields higher correctness beyond a per‑observation complexity threshold (z ≈ + 0.41) without a time cost; Structured benefits novices at mid complexity. We introduce a mode‑agnostic verification‑load index (failures, time‑to‑first‑compile, churn, pauses, switches) that partially mediates rising stress/fatigue across tasks. We translate these findings into design guidance: adaptive mode orchestration, transparency on demand, and verification aware packaging, and propose reporting verification load alongside outcomes to evaluate interfaces as models evolve.}
}

@inproceedings{10.65109/SEOT8410,
  author = {Danassis, Panayiotis and Goel, Naman},
  title = {Can Vibe Coding Beat Graduate CS Students? An LLM vs. Human Coding Tournament on Market-driven Strategic Planning},
  booktitle = {Proceedings of the 25th International Conference on Autonomous Agents and Multiagent Systems},
  year = {2026},
  month = {may},
  pages = {357–366},
  numpages = {10},
  publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
  address = {Richland, SC},
  doi = {10.65109/SEOT8410},
  url = {https://doi.org/10.65109/SEOT8410},
  isbn = {9798400723179},
  keywords = {large language models (llms), code generation, vibe coding, benchmarks, human evaluation},
  abstract = {The rapid proliferation of Large Language Models (LLMs) has revolutionized AI-assisted code generation. This rapid development of LLMs has outpaced our ability to properly benchmark them. Prevailing benchmarks emphasize unit-test pass rates and syntactic correctness. Such metrics understate the difficulty of many real-world problems that require planning, optimization, and strategic interaction. We introduce a multi-agent reasoning-driven benchmark based on a real-world logistics optimization problem (Auction, Pickup, and Delivery Problem) that couples competitive auctions with capacity-constrained routing. The benchmark requires building agents that can (i) bid strategically under uncertainty and (ii) optimize planners that deliver tasks while maximizing profit. We evaluate 40 LLM-coded agents (by a wide range of state-of-the-art LLMs under multiple prompting methodologies, including vibe coding) against 17 human-coded agents developed before the advent of LLMs. Our results over 12 double all-play-all tournaments and  sim 40k matches demonstrate (i) a clear superiority of human(graduate students)-coded agents: the top 5 spots are consistently won by human-coded agents, (ii) the majority of LLM-coded agents (33 out of 40) are beaten by very simple baselines, and (iii) given the best human solution as an input and prompted to improve upon, the best performing LLM makes the solution significantly worse instead of improving it. Our results highlight a gap in LLMs' ability to produce code that works competitively in the real-world, and motivate new evaluations that emphasize reasoning-driven code synthesis in real-world scenarios.}
}

@article{10.1145/3845606,
  author = {Matsutani, Yuki and Nitta, Yasuhiro and Sugimoto, Maki},
  title = {LLiBTree: An Assessment of Usability and Trust of LLM-integrated Behavior Tree Nodes for Robot Programming},
  journal = {ACM Trans. Interact. Intell. Syst.},
  year = {2026},
  month = {sep},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3845606},
  url = {https://doi.org/10.1145/3845606},
  issn = {2160-6455},
  keywords = {Robotic Programming, Behavior Trees, Large Language Models, LLM Integration, Trust, Usability, Automated Systems, Natural Language Programming},
  abstract = {As robot programming becomes increasingly important in enabling non-expert users to customize autonomous systems across domains such as manufacturing, healthcare, and service industries, there is a growing demand for methods that are both intuitive and support users’ perceived trust. While natural language programming (NLP) lowers the barrier to entry by allowing users to describe robot behavior in everyday language, it often lacks structural transparency—particularly when paired with opaque deep learning models. To address this challenge, we present LLiBTree, a novel robot programming framework that integrates Large Language Models (LLMs) directly into Behavior Trees (BTs) as executable nodes. This approach allows users to iteratively define and refine robot behavior via natural language while preserving the modularity and clarity of visual programming. By embedding the LLM within the BT, users can generate and replace sub-trees in response to natural language instructions, enabling a seamless blend of language-based flexibility and structured visual logic. We evaluate LLiBTree through a controlled user study, comparing it with both natural language-only and conventional visual programming methods. The results show that the PreGeneratedLLiBTree condition yields significantly higher perceived trust, while LLiBTree conditions achieve usability that is non-inferior to natural language-only programming and improve users’ sense of agency, suggesting that LLiBTree offers a practical approach for end-user robot programming.}
}

@inproceedings{10.1145/3856208.3856211,
  author = {Gürtl, Sebastian and Sibia, Naaz and Kerschbaumer, David and Guetl, Christian and Liut, Michael and Steinmaurer, Alexander},
  title = {DUET: Rapid Automated Feedback for UML Class Diagrams and ER Diagrams},
  booktitle = {Proceedings of the 26th Koli Calling International Conference on Computing Education Research},
  year = {2026},
  month = {nov},
  number = {Article 3},
  pages = {1–12},
  numpages = {12},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  doi = {10.1145/3856208.3856211},
  url = {https://doi.org/10.1145/3856208.3856211},
  isbn = {9798400727528},
  keywords = {Feedback Generation, Student Support, Unified Modeling Language, Entity-Relationship Diagram, Generative AI},
  abstract = {Providing timely, clear, and actionable feedback is a persistent challenge in large computing courses, where feedback often arrives only after grading and is reduced to brief, rubric-oriented comments. Conceptual models such as Unified Modeling Language (UML) class diagrams and Entity-Relationship (ER) diagrams are particularly affected, as assessing them requires interpreting each student’s individual design. We present DUET, a web-based tool that provides formative feedback on conceptual models while students are still working on them. Students upload their diagrams as images, whether hand-drawn or digitally created. DUET\&nbsp;converts them to PlantUML through a decomposed multimodal large language model (MLLM) pipeline, compares its structure against instructor-provided reference solutions, and phrases the detected differences as neutral, reflective prompts that encourage revision without revealing the solution. Students can rate each feedback message and resubmit revised diagrams for iterative feedback. Educators manage assignments and editable reference solutions. Following a design-based research approach, we refined the design through formative interviews with six educators and deployed the tool in an introductory object-oriented programming course, where 135 students voluntarily uploaded 530 UML class diagrams while preparing for a graded modeling assignment. Half of the students revised their diagram at least once in response to feedback, typically within minutes of receiving it. An evaluation of the pipeline showed that it produced feedback based on a faithful conversion of the drawing for 74\% of these authentic submissions. In addition, pre-/post-surveys show that students experienced the feedback as supportive and manageable but frequently doubted its correctness, while trust in large language models (LLMs) remained unchanged and confidence in UML class diagram modeling tended to increase. Based on these findings, we discuss design lessons for integrating LLM-based diagram feedback as formative learning support, and we release the tool, its prompts, and the study data.}
}

