@INPROCEEDINGS{11605408,
  author={Chen, Jingcao and Fan, Yi and Xia, Chunfa and Tang, Yin and Sun, Wenjie and Wu, Weijie},
  booktitle={2026 3rd International Conference on Algorithms, Software Engineering and Network Security (ASENS)}, 
  title={An Intelligent Fault Diagnosis Method for Catenary Based on AI Agent and RAG Technology}, 
  year={2026},
  volume={},
  number={},
  pages={393-396},
  abstract={To address the persistent challenges of long processing time and limited accuracy in traditional catenary fault diagnosis, this paper proposes an intelligent diagnostic framework integrating AI Agent and Retrieval-Augmented Generation (RAG) technologies. The core of the method utilizes a Large Language Model (LLM) as a cognitive agent, which actively orchestrates the retrieval and fusion of multi-source operational data. It dynamically queries a domain-specific knowledge graph through RAG to obtain relevant historical fault cases and expert knowledge, thereby grounding the diagnostic reasoning in verified domain expertise. Experimental evaluations on real historical fault data demonstrate that the proposed framework significantly outperforms conventional rule-based and data-driven methods. It achieves a diagnostic accuracy of 95% for typical faults, reduces the average diagnosis time to 3.5 seconds, and enables proactive early warnings with a lead time of approximately 15 days for progressive defects. The results confirm the method’s substantial improvements in efficiency, accuracy, and interpretability for intelligent railway maintenance.},
  keywords={Modeling;Retrieval augmented generation;Knowledge graphs;Large language models;Artificial intelligence;Rail transportation;Timing;Printing;Cognition;Cognitive systems;catenary;fault diagnosis;AI agent;RAG;LLM;knowledge graph},
