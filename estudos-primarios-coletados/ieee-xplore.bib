@ARTICLE{11690565,
  author={Wang, Dae-Sung and Kim, Sangryul and Jung, Dongin and Kim, Tae-Il and Park, Junhyung and Lee, Chan-Gun},
  journal={IEEE Access}, 
  title={RABTR: Retrieval-Augmented Bug Triage With Reasoning}, 
  year={2026},
  volume={14},
  number={},
  pages={142519-142534},
  abstract={Automatic bug triage aims to recommend appropriate developers for newly reported issues. While prior work has focused on improving recommendation accuracy, little attention has been given to supporting developers with explanations for these recommendations. In this paper, we present a retrieval-augmented framework for bug triage that integrates both predictions and explanations. We propose retrieval-based automatic bug triage (RABT), a semantic retrieval method that identifies similar past issues using vector-based embeddings, and retrieval-augmented bug triage with reasoning (RABTR), a reasoning method that generates natural language explanations grounded in retrieved evidence. To assess the practical utility and robustness of our approach, we conduct experiments on six real-world datasets. We further perform a time-split evaluation to reflect real-world maintenance scenarios, where RABT consistently outperforms state-of-the-art methods, including TF-IDF, BM25, and DBRNN-A, with an improvement of up to 26.10 percentage points in top-10 accuracy. To evaluate the quality of the generated explanations, we introduce a checklist-based evaluation method combining GPT-4.1 and human annotation. The results show strong alignment between model and human evaluations on key dimensions such as accuracy, precision, and conciseness. The ablation analysis also reveals that explanation quality is highly sensitive to retrieval input, reinforcing the importance of semantic retrieval in reasoning-augmented systems. Our findings highlight the potential of integrating semantic retrieval and large language model-based reasoning to improve both the transparency and effectiveness of automatic bug triage.},
  keywords={Modeling;Computer bugs;Cognition;Cognitive systems;Accuracy;Conferences;Large language models;Software engineering;Natural languages;Generative Pre-trained transformer;Bug triage;semantic retrieval;LLM-based explanation;human evaluation;software maintenance},
  doi={10.1109/ACCESS.2026.3733430},
  ISSN={2169-3536},
  month={},}

@ARTICLE{11755373,
  author={Yang, Shuo and Zheng, Xinran and Xu, Jinfeng and Li, Jinze and Liu, Zewei and Xu, Zhanfeng and Xing, Zheng and Shi, Siping and Ngai, Edith C. H.},
  journal={IEEE Internet of Things Journal}, 
  title={HAO-IDS: Hierarchical Multi-Agent Orchestration for Adaptive Network Intrusion Detection}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={Intrusion detection in open network environments remains challenging due to evolving attack patterns, distribution shift, and the limited interpretability of conventional detectors. Recent LLM-enhanced approaches improve semantic analysis and explanation generation, but they often apply uniform reasoning to all traffic instances and lack mechanisms for post-deployment adaptation. In this paper, we propose HAO-IDS, a hierarchical multi-agent framework for adaptive intrusion detection. HAO-IDS formulates detection as a state-aware orchestration process over three reasoning levels, including a lightweight Fast Filter, a domain-adapted Expert Analyst, and a high-capacity Threat Responder, so that computational effort can be allocated according to instance difficulty. To enable dynamic routing in evolving environments, we further introduce an environment-aware perception module that combines dual-view traffic representation with drift estimation, as well as a continual memory adaptation mechanism that integrates environment, experience, intelligence, and parameter memory. HAO-IDS also supports retrieval-augmented threat reporting to produce evidence-grounded decisions and actionable response guidance. Extensive experiments on two intrusion detection benchmarks show that HAO-IDS achieves F1-scores of 0.914 on CIC-IoT23 and 0.907 on UNSW-NB15, outperforming the strongest agent-based baseline by 3.4 percentage points on both datasets. It also raises the zero-day detection rate from 0.642 to 0.731 and reduces the average inference latency by 12.5% without relying on external API services. These results validate the effectiveness of hierarchical orchestration and continual memory adaptation for practical LLM-enhanced intrusion detection.},
  keywords={Modeling;Internet of Things;Cognition;Cognitive systems;Memory;Intrusion detection;Large language models;Signal detection;Accuracy;Poles and zeros;Network Intrusion Detection;Multi-Agent System;Large Language Model},
  doi={10.1109/JIOT.2026.3748010},
  ISSN={2327-4662},
  month={},}

@INPROCEEDINGS{11728922,
  author={Meng, Qianru and Zhang, Xiao and Ren, Zhaochun and Visser, Joost},
  booktitle={2026 International Joint Conference on Neural Networks (IJCNN)}, 
  title={When More Retrieval Hurts: Retrieval-Augmented Code Review Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-8},
  abstract={Code review generation can reduce developer effort by producing concise, reviewer-style feedback for a given code snippet or code change. However, generation-only models often produce generic or off-point reviews, while retrieval-only methods struggle to adapt well to new contexts. In this paper, we view retrieval augmentation for code review as retrieval-augmented in-context learning: retrieved historical reviews are placed in the input context as examples that guide the model’s output. Based on this view, we propose RARe (Retrieval-Augmented code Reviewer), a framework that retrieves relevant historical reviews from a corpus and conditions a large language model on the retrieved in-context examples. Experiments on two public benchmarks show that RARe outperforms strong baselines and reaches BLEU-4 scores of 12.32 and 12.96. A key finding is that more retrieval can hurt: using only the top-1 retrieved example works best, while adding more retrieved items can degrade performance due to redundancy and conflicting cues under limited context budgets. Human evaluation and interpretability analysis further support that retrieval-augmented generation reduces generic outputs and improves review focus.},
  keywords={Codes;Modeling;Reviews;Printing;Context;Retrieval augmented generation;Conferences;Training;Software engineering;Generators;code review;retrieval-augmented generation;incontext learning;large language models;software engineering},
  doi={10.1109/IJCNN69854.2026.11728922},
  ISSN={2161-4407},
  month={June},}

@INPROCEEDINGS{11751116,
  author={Peng, Gaojun and Li, Dapeng and Guo, Shuang and Su, Ya and Yu, Tianxue},
  booktitle={2026 6th International Conference on Software Engineering and Artificial Intelligence (SEAI)}, 
  title={RPCOT-LMC: A Large-Small Models Collaborative Approach for Low-Resource Contract Risk Analysis}, 
  year={2026},
  volume={},
  number={},
  pages={339-343},
  abstract={Automated contract risk review remains challenging in low-resource legal settings due to the scarcity of expert annotations and the high cost of domain-specific data, which limits the applicability of large-scale supervised fine-tuning methods. To address this issue, this paper proposes a large-small model collaborative approach for low-resource contract risk analysis and introduces RPCOT-LMC (Risk Point Chain-of-Thought with Large-Small Model Collaboration). The framework integrates risk point-oriented chain-of-thought reasoning with collaboration between a cloud-based large language model and a lightweight, domain-adapted small language model, where structured legal reasoning paths generated by the teacher model are distilled into an edge-deployable student model to reduce annotation dependence and support efficient local inference. Experiments on a self-constructed Grassland Contract Risk Dataset (GCRD) and the CUAD benchmark demonstrate that RPCOT-LMC achieves consistent performance improvements under low-resource and cross-domain settings, attaining an F1-score of 91.1% on GCRD. Expert evaluations further indicate a reasoning coverage of 90.3%, highlighting the framework's improved interpretability and its feasibility for practical deployment in resource-constrained legal environments.},
  keywords={Modeling;Contracts;Cognition;Cognitive systems;Labeling;Printing;Clouds;Large language models;Tuning;Annotations;Contract Risk Review;Low-resource Learning;Chain-of-Thought;Language Model Collaboration},
  doi={10.1109/SEAI70065.2026.11751116},
